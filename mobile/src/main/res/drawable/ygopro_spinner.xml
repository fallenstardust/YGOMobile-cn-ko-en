<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 底色 + 0.3dp圆角外框线 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ygopro_list_background" />
            <corners android:radius="2dp" />
            <stroke
                android:width="0.3dp"
                android:color="@color/holo_blue_light" />
        </shape>
    </item>

    <!-- 右侧仿Spinner圆角矩形框（高度占满，宽为高的1/4） -->
    <item
        android:width="6dp"
        android:gravity="right|fill_vertical">
        <vector
            android:width="6dp"
            android:height="24dp"
            android:viewportWidth="6"
            android:viewportHeight="24">

            <!-- 外层圆角矩形框（描边，上下各留1缝隙，圆角半径1，内部填充navy） -->
            <path
                android:pathData="M1.4,1.15 L4.6,1.15 A1,1 0 0,1 5.6,2.15 L5.6,21.85 A1,1 0 0,1 4.6,22.85 L1.4,22.85 A1,1 0 0,1 0.4,21.85 L0.4,2.15 A1,1 0 0,1 1.4,1.15 Z"
                android:strokeWidth="0.3"
                android:strokeColor="@color/colorMain"
                android:fillColor="@color/colorNavy" />

            <!-- 内嵌等边三角形（边长2.9，与框内边留1缝隙，居中） -->
            <path
                android:fillColor="@color/colorMain"
                android:pathData="M1.55,10.74 L4.45,10.74 L3,13.26 Z" />

        </vector>
    </item>

</layer-list>