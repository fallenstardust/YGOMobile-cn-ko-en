<?xml version="1.0" encoding="utf-8"?><!--
  持续适用中效果徽标的外发光底（作为 iv_*_applying 的 background，图标本体留 padding 露出光晕）：
  径向渐变椭圆，中心亮金向外淡出到全透明，配合 GameTopInfoManager 的闪动动画形成
  「本侧有整回合/整局一直适用中的效果」的呼吸式金色外发光提示（比撤回光晕更亮一档，
  需长期可见但不催促点击）。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <gradient
        android:centerColor="#80FFC107"
        android:endColor="#00FFC107"
        android:gradientRadius="50%p"
        android:startColor="#E6FFF3C4"
        android:type="radial" />
</shape>
