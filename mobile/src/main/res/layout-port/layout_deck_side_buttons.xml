<?xml version="1.0" encoding="utf-8"?><!-- 卡组编辑器侧边按钮列·竖屏变体 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layout_deck_side_buttons"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="bottom|center_horizontal"
    android:visibility="gone">

    <!-- 左组：设置/音乐靠左贴边 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="left"
        android:orientation="horizontal">

        <!-- 设置键：尺寸对齐竖屏决斗 layout_game_right 的 btn_settings -->
        <ImageButton
            android:id="@+id/btn_deck_settings"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginEnd="5dp"
            android:background="@drawable/btn_sci_fi_bg"
            android:padding="3dp"
            android:scaleType="fitCenter"
            android:src="@drawable/setting" />

        <!-- 音乐开关键：同设置键 -->
        <ImageButton
            android:id="@+id/btn_deck_sound"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/btn_sci_fi_bg"
            android:padding="3dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_volume_on" />
    </LinearLayout>

    <!-- 中组：退出多选 + 撤销/重做整组在屏幕底部居中 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="horizontal">

        <!-- 批量勾选模式的退出键：常驻占位，只在长按进入批量多选模式时点亮（非模式内走
             INVISIBLE 而非 GONE，避开进出模式时本键的插入把整行按钮顶位），
             点击即清空全部勾选并退出多选模式；按用户规格取左绿勾右多选 -->
        <Button
            android:id="@+id/btn_deck_batch_exit"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginEnd="5dp"
            android:background="@drawable/button_radius_black_transparents"
            android:clickable="true"
            android:drawableStart="@drawable/ic_effect_used_check"
            android:drawablePadding="2dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingLeft="5dp"
            android:paddingRight="5dp"
            android:text="@string/batch_mode_exit"
            android:textColor="@color/white"
            android:textSize="9sp"
            android:visibility="invisible" />

        <!-- 撤销/重做：由 DeckEditorHistoryPanel 按共享卡组历史点亮，重做键 scaleX=-1 镜像 -->
        <ImageButton
            android:id="@+id/btn_deck_undo"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginEnd="5dp"
            android:background="@drawable/rotate"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/undo"
            android:visibility="invisible" />

        <ImageButton
            android:id="@+id/btn_deck_redo"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginEnd="5dp"
            android:background="@drawable/rotate"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:scaleX="-1"
            android:src="@drawable/undo"
            android:visibility="invisible" />
    </LinearLayout>
</FrameLayout>
