<?xml version="1.0" encoding="utf-8"?>
<!-- 卡组编辑器侧边功能按钮列·横屏变体（纵向排列）-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layout_deck_side_buttons"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="bottom"
    android:orientation="vertical"
    android:visibility="visible">

    <!-- 批量勾选模式的退出键 -->
    <Button
        android:id="@+id/btn_deck_batch_exit"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginBottom="5dp"
        android:background="@drawable/button_radius_black_transparents"
        android:clickable="true"
        android:drawableTop="@drawable/ic_effect_used_check"
        android:drawablePadding="1dp"
        android:gravity="center"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:paddingLeft="2dp"
        android:paddingTop="1dp"
        android:paddingRight="2dp"
        android:paddingBottom="1dp"
        android:text="@string/batch_mode_exit"
        android:textColor="@color/white"
        android:textSize="9sp"
        android:visibility="invisible" />

    <!-- 撤销/重做 -->
    <ImageButton
        android:id="@+id/btn_deck_undo"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginBottom="5dp"
        android:background="@drawable/rotate"
        android:padding="10dp"
        android:scaleType="fitCenter"
        android:src="@drawable/undo"
        android:visibility="invisible" />

    <ImageButton
        android:id="@+id/btn_deck_redo"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginBottom="5dp"
        android:background="@drawable/rotate"
        android:padding="10dp"
        android:scaleType="fitCenter"
        android:scaleX="-1"
        android:src="@drawable/undo"
        android:visibility="invisible" />

    <!-- 设置/音乐两键：wrap_content + min/max(30..40dp) + padding=4dp + adjustViewBounds；
         列纵向锚底，两键排在列尾贴住界面下缘 -->
    <ImageButton
        android:id="@+id/btn_deck_settings"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="5dp"
        android:adjustViewBounds="true"
        android:background="@drawable/btn_sci_fi_bg"
        android:maxWidth="40dp"
        android:maxHeight="40dp"
        android:minWidth="30dp"
        android:minHeight="30dp"
        android:padding="4dp"
        android:scaleType="fitCenter"
        android:src="@drawable/setting" />

    <ImageButton
        android:id="@+id/btn_deck_sound"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:background="@drawable/btn_sci_fi_bg"
        android:maxWidth="40dp"
        android:maxHeight="40dp"
        android:minWidth="30dp"
        android:minHeight="30dp"
        android:padding="4dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_volume_on" />
</LinearLayout>
