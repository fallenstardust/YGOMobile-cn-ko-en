<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card_select_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/sdialogl"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp">

    <TextView
        android:id="@+id/tv_card_select_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="选择卡片"
        android:textColor="@color/white"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/tv_card_select_count"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:text="已选: 0/0"
        android:textColor="#FFFF00"
        android:textSize="9sp" />

    <LinearLayout
        android:id="@+id/layout_card_slots"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/slot_card_0"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="4dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_card_pos_0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#335577"
                android:gravity="center"
                android:textColor="@color/white"
                android:textSize="8sp" />

            <ImageView
                android:id="@+id/iv_card_0"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:layout_marginTop="2dp"
                android:background="#222222"
                android:scaleType="fitCenter"
                android:src="@drawable/unknown" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/slot_card_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="4dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_card_pos_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#335577"
                android:gravity="center"
                android:textColor="@color/white"
                android:textSize="8sp" />

            <ImageView
                android:id="@+id/iv_card_1"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:layout_marginTop="2dp"
                android:background="#222222"
                android:scaleType="fitCenter"
                android:src="@drawable/unknown" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/slot_card_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="4dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_card_pos_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#335577"
                android:gravity="center"
                android:textColor="@color/white"
                android:textSize="8sp" />

            <ImageView
                android:id="@+id/iv_card_2"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:layout_marginTop="2dp"
                android:background="#222222"
                android:scaleType="fitCenter"
                android:src="@drawable/unknown" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/slot_card_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="4dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_card_pos_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#335577"
                android:gravity="center"
                android:textColor="@color/white"
                android:textSize="8sp" />

            <ImageView
                android:id="@+id/iv_card_3"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:layout_marginTop="2dp"
                android:background="#222222"
                android:scaleType="fitCenter"
                android:src="@drawable/unknown" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/slot_card_4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="4dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_card_pos_4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#335577"
                android:gravity="center"
                android:textColor="@color/white"
                android:textSize="8sp" />

            <ImageView
                android:id="@+id/iv_card_4"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:layout_marginTop="2dp"
                android:background="#222222"
                android:scaleType="fitCenter"
                android:src="@drawable/unknown" />
        </LinearLayout>
    </LinearLayout>

    <SeekBar
        android:id="@+id/sb_card_page"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:max="0" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_card_select_ok"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="20dp"
            android:background="@drawable/button3_bg"
            android:minWidth="90dp"
            android:minHeight="30dp"
            android:text="确定"
            android:textColor="@color/white"
            android:textSize="10sp" />

        <Button
            android:id="@+id/btn_card_select_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/button3_bg"
            android:minWidth="90dp"
            android:minHeight="30dp"
            android:text="取消"
            android:textColor="@color/white"
            android:textSize="10sp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>