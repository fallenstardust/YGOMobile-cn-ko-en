<!-- 左侧卡片详情面板（常驻显示） -->
<LinearLayout android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:id="@+id/layout_card_detail"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.85"
        android:orientation="vertical"
        android:padding="1dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.45">

            <ImageView
                android:id="@+id/iv_card_image"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignParentStart="true"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:src="@drawable/unknown" />

            <!-- 控制按钮高度分配方案：每个按钮 0dp+weight=1 均匀分配整列高度（各按钮等高、
                 铺满按钮列），并声明 maxHeight=30dp 作为高度上限提示；投降/退出编辑等按钮同样等分 -->
            <!-- 时点按钮（投降/时点控制） -->
            <LinearLayout
                android:id="@+id/layout_bottom_actions"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="2dp"
                android:layout_toEndOf="@id/iv_card_image"
                android:orientation="vertical"
                android:visibility="visible">

                <Button
                    android:id="@+id/btn_surrender"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginBottom="2dp"
                    android:maxHeight="50dp"
                    android:minHeight="0dp"
                    android:background="@drawable/button3_bg"
                    android:text="投降"
                    android:textColor="@color/white"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/btn_ignore_timing"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginBottom="2dp"
                    android:maxHeight="30dp"
                    android:minHeight="0dp"
                    android:background="@drawable/button3_bg"
                    android:text="忽略时点"
                    android:textColor="@color/white"
                    android:textSize="10sp"
                    android:visibility="invisible" />

                <Button
                    android:id="@+id/btn_show_timing"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginBottom="2dp"
                    android:maxHeight="30dp"
                    android:minHeight="0dp"
                    android:background="@drawable/button3_bg"
                    android:text="显示时点"
                    android:textColor="@color/white"
                    android:textSize="10sp"
                    android:visibility="invisible" />

                <Button
                    android:id="@+id/btn_available_timing"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginBottom="2dp"
                    android:maxHeight="30dp"
                    android:minHeight="0dp"
                    android:background="@drawable/button3_bg"
                    android:text="可用时点"
                    android:textColor="@color/white"
                    android:textSize="10sp"
                    android:visibility="invisible" />

                <Button
                    android:id="@+id/btn_shuffle_hand"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:maxHeight="30dp"
                    android:minHeight="0dp"
                    android:background="@drawable/button3_bg"
                    android:text="洗切手卡"
                    android:textColor="@color/white"
                    android:textSize="10sp"
                    android:visibility="invisible" />

                <Button
                    android:id="@+id/btn_cancel_or_finish"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:maxHeight="30dp"
                    android:minHeight="0dp"
                    android:background="@drawable/button3_bg"
                    android:text="完成选择"
                    android:textColor="@color/white"
                    android:textSize="10sp"
                    android:visibility="gone" />

            </LinearLayout>
            <!-- 录像控制按钮 -->
            <LinearLayout
                android:id="@+id/layout_replay_control"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="2dp"
                android:layout_toEndOf="@id/iv_card_image"
                android:orientation="vertical"
                android:visibility="gone">

                <Button
                    android:id="@+id/btn_replay_play"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginBottom="2dp"
                    android:maxHeight="30dp"
                    android:minHeight="0dp"
                    android:background="@drawable/button3_bg"
                    android:text="播放"
                    android:textColor="@color/white"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/btn_replay_pause"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginBottom="2dp"
                    android:maxHeight="30dp"
                    android:minHeight="0dp"
                    android:background="@drawable/button3_bg"
                    android:text="暂停"
                    android:textColor="@color/white"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/btn_replay_next"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginBottom="2dp"
                    android:maxHeight="30dp"
                    android:minHeight="0dp"
                    android:background="@drawable/button3_bg"
                    android:text="下一步"
                    android:textColor="@color/white"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/btn_replay_last"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginBottom="2dp"
                    android:maxHeight="30dp"
                    android:minHeight="0dp"
                    android:background="@drawable/button3_bg"
                    android:text="上一步"
                    android:textColor="@color/white"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/btn_replay_shuffle"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginBottom="2dp"
                    android:maxHeight="30dp"
                    android:minHeight="0dp"
                    android:background="@drawable/button3_bg"
                    android:text="切换视角"
                    android:textColor="@color/white"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/btn_replay_quit"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:maxHeight="30dp"
                    android:minHeight="0dp"
                    android:background="@drawable/button3_bg"
                    android:text="退出"
                    android:textColor="@color/white"
                    android:textSize="10sp" />
            </LinearLayout>
            <!-- 观战控制按钮集：平时隐藏，仅观战时显示（代替录像控制条的切换视角/退出），
                 含跳到当前/切换视角/退出（对齐需求5：观战者可一键跳到最新决斗局面） -->
            <LinearLayout
                android:id="@+id/layout_spectator_control"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="2dp"
                android:layout_toEndOf="@id/iv_card_image"
                android:orientation="vertical"
                android:visibility="gone">

                <Button
                    android:id="@+id/btn_spectator_skip"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="2dp"
                    android:maxHeight="30dp"
                    android:minHeight="0dp"
                    android:background="@drawable/button3_bg"
                    android:text="@string/spectator_skip_to_current"
                    android:textColor="@color/white"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/btn_spectator_swap"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="2dp"
                    android:maxHeight="30dp"
                    android:minHeight="0dp"
                    android:background="@drawable/button3_bg"
                    android:text="切换视角"
                    android:textColor="@color/white"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/btn_spectator_quit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxHeight="30dp"
                    android:minHeight="0dp"
                    android:background="@drawable/button3_bg"
                    android:text="退出"
                    android:textColor="@color/white"
                    android:textSize="10sp" />
            </LinearLayout>
            <!-- 卡组操作按钮 -->
            <LinearLayout
                android:id="@+id/layout_deck_control"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="2dp"
                android:layout_toEndOf="@id/iv_card_image"
                android:orientation="vertical"
                android:visibility="gone">

                <Button
                    android:id="@+id/btn_deck_exit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="2dp"
                    android:maxHeight="50dp"
                    android:minHeight="0dp"
                    android:background="@drawable/button3_bg"
                    android:text="@string/quit"
                    android:textColor="@color/white"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/btn_deck_shuffle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="2dp"
                    android:maxHeight="30dp"
                    android:minHeight="0dp"
                    android:background="@drawable/button3_bg"
                    android:text="@string/unsort"
                    android:textColor="@color/white"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/btn_deck_sort"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="2dp"
                    android:maxHeight="30dp"
                    android:minHeight="0dp"
                    android:background="@drawable/button3_bg"
                    android:text="@string/sort"
                    android:textColor="@color/white"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/btn_deck_clear"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="2dp"
                    android:maxHeight="30dp"
                    android:minHeight="0dp"
                    android:background="@drawable/button3_bg"
                    android:text="@string/clear_deck"
                    android:textColor="@color/white"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/btn_deck_delete"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="2dp"
                    android:maxHeight="30dp"
                    android:minHeight="0dp"
                    android:background="@drawable/button3_bg"
                    android:text="@string/delete"
                    android:textColor="@color/white"
                    android:textSize="10sp" />
            </LinearLayout>
        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.55"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginTop="2dp"
                android:layout_weight="1"
                android:background="@drawable/window3"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_card_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/btn_sci_fi_bg"
                    android:gravity="center"
                    android:padding="2dp"
                    android:text="Unknown[999999999]"
                    android:textColor="@color/white"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="left"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_card_attr"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="[怪兽|效果] 种族/属性"
                            android:textColor="@color/holo_green_bright"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/tv_card_level"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="[★13] 5000/5000"
                            android:textColor="@color/yellow"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/tv_card_setname"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="字段：????"
                            android:textColor="@color/holo_orange_bright"
                            android:textSize="10sp"
                            android:visibility="visible" />
                    </LinearLayout>

                    <!-- 关联卡片入口：参考 dialog_cardinfo 的 btn_related，点击后按当前卡的字段/卡名/描述
                     关键词聚合关联卡并在决斗态弹关键词列表、卡组编辑态填搜索结果列表；无关联卡时隐藏 -->
                    <ImageButton
                        android:id="@+id/btn_related_cards"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:src="@drawable/ic_related"
                        android:background="@drawable/list_item_bg"
                        android:visibility="visible" />
                </FrameLayout>

                <ScrollView
                    android:id="@+id/sv_card_desc"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="6dp"
                    android:layout_weight="1">

                    <TextView
                        android:id="@+id/tv_card_desc"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:textColor="@color/white"
                        android:textSize="11sp" />
                </ScrollView>
            </LinearLayout>
    </LinearLayout>
    </LinearLayout>
</LinearLayout>