<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_deck_editor_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- ================= 顶部区域：卡组信息 + 筛选 ================= -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.2"
        android:orientation="horizontal">

        <!-- 左侧：卡组信息面板 -->
        <LinearLayout
            android:id="@+id/layout_deck_info_panel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.4"
            android:background="@drawable/sdialogl"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_label_deck"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp"
                android:text="卡组:"
                android:textColor="@color/white"
                android:textSize="8sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_deck_manager"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="0.75"
                    android:background="@drawable/btn_sci_fi_bg"
                    android:text="@string/deck_manager"
                    android:textColor="@color/white"
                    android:textSize="8sp" />

                <Button
                    android:id="@+id/btn_deck_save"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0.25"
                    android:background="@drawable/button3_bg"
                    android:text="@string/save"
                    android:textColor="@color/white"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="2dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/et_deck_name"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="0.75"
                    android:background="@drawable/ygopro_base_background"
                    android:inputType="text"
                    android:paddingStart="4dp"
                    android:textColor="@color/white"
                    android:textColorHint="#888888"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/btn_deck_save_as"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0.25"
                    android:background="@drawable/button3_bg"
                    android:text="@string/save_as_deck"
                    android:textColor="@color/white"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 右侧：筛选面板 -->
        <LinearLayout
            android:id="@+id/layout_filter_panel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="5dp"
            android:layout_weight="0.6"
            android:background="@drawable/sdialogl"
            android:orientation="horizontal">


            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- 种类 + 禁限 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_label_type"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="0.2"
                        android:gravity="center|start"
                        android:text="种类:"
                        android:textColor="@color/white"
                        android:textSize="8sp" />

                    <Spinner
                        android:id="@+id/spinner_filter_type"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="0.3"
                        android:background="@drawable/ygopro_spinner" />

                    <TextView
                        android:id="@+id/tv_label_type2"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="0.2"
                        android:gravity="center|start"
                        android:layout_marginStart="2dp"
                        android:text="子类："
                        android:textColor="@color/white"
                        android:textSize="8sp" />

                    <Spinner
                        android:id="@+id/spinner_filter_type2"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="0.3"
                        android:background="@drawable/ygopro_spinner" />
                </LinearLayout>

                <!-- 属性 + 攻击 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="2dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_label_attribute"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="0.2"
                        android:gravity="center|start"
                        android:text="属性:"
                        android:textColor="@color/white"
                        android:textSize="8sp" />

                    <Spinner
                        android:id="@+id/spinner_filter_attribute"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="0.3"
                        android:background="@drawable/ygopro_spinner" />

                    <TextView
                        android:id="@+id/tv_label_race"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="0.2"
                        android:gravity="center|start"
                        android:layout_marginStart="2dp"
                        android:text="种族:"
                        android:textColor="@color/white"
                        android:textSize="8sp" />

                    <Spinner
                        android:id="@+id/spinner_filter_race"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="0.3"
                        android:background="@drawable/ygopro_spinner" />

                </LinearLayout>

                <!-- 星数 / 刻度 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="2dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_label_star"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="0.2"
                        android:gravity="center|start"
                        android:text="星数:"
                        android:textColor="@color/white"
                        android:textSize="8sp" />

                    <EditText
                        android:id="@+id/et_filter_star"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="0.3"
                        android:background="@drawable/ygopro_base_background"
                        android:inputType="number"
                        android:textColor="@color/white"
                        android:textSize="8sp" />

                    <TextView
                        android:id="@+id/tv_label_scale"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="0.2"
                        android:gravity="center|start"
                        android:layout_marginStart="2dp"
                        android:text="刻度:"
                        android:textColor="@color/white"
                        android:textSize="8sp" />

                    <EditText
                        android:id="@+id/et_filter_scale"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="0.3"
                        android:background="@drawable/ygopro_base_background"
                        android:inputType="number"
                        android:paddingStart="4dp"
                        android:textColor="@color/white"
                        android:textColorHint="#888888"
                        android:textSize="8sp" />
                </LinearLayout>

                <!-- 连接标记 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="2dp"
                    android:layout_weight="1.5"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_filter_effect"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:layout_weight="1"
                        android:background="@drawable/button3_bg"
                        android:text="效果"
                        android:textColor="@color/white"
                        android:textSize="8sp" />

                    <Button
                        android:id="@+id/btn_filter_marks"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:layout_marginStart="2dp"
                        android:layout_weight="2"
                        android:background="@drawable/button3_bg"
                        android:text="连接标记"
                        android:textColor="@color/white"
                        android:textSize="8sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="2"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="2"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tv_label_limit"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="0.2"
                                android:gravity="center|start"
                                android:text="禁限:"
                                android:textColor="@color/white"
                                android:textSize="8sp" />

                            <Spinner
                                android:id="@+id/spinner_filter_limit"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="0.8"
                                android:background="@drawable/ygopro_spinner" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_marginVertical="2dp"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tv_label_attack"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="0.2"
                                android:gravity="center|start"
                                        android:text="ATK:"
                                        android:textColor="@color/white"
                                        android:textSize="8sp" />

                                    <EditText
                                        android:id="@+id/et_filter_attack"
                                        android:layout_width="0dp"
                                        android:layout_height="match_parent"
                                        android:layout_weight="0.3"
                                        android:background="@drawable/ygopro_base_background"
                                        android:inputType="text"
                                        android:paddingStart="4dp"
                                        android:textColor="@color/white"
                                        android:textSize="8sp" />

                                    <TextView
                                        android:id="@+id/tv_label_defense"
                                        android:layout_width="0dp"
                                        android:layout_height="match_parent"
                                        android:layout_marginStart="2dp"
                                        android:layout_weight="0.2"
                                        android:gravity="center|start"
                                        android:text="DEF:"
                                        android:textColor="@color/white"
                                        android:textSize="8sp" />

                                    <EditText
                                        android:id="@+id/et_filter_defense"
                                        android:layout_width="0dp"
                                        android:layout_height="match_parent"
                                        android:layout_marginStart="2dp"
                                        android:layout_weight="0.3"
                                        android:background="@drawable/ygopro_base_background"
                                        android:inputType="text"
                                        android:paddingStart="4dp"
                                        android:textColor="@color/white"
                                        android:textSize="8sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginBottom="2dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_label_keyword"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="0.2"
                        android:gravity="center|start"
                        android:text="关键字:"
                        android:textColor="@color/white"
                        android:textSize="8sp" />

                    <EditText
                        android:id="@+id/et_filter_keyword"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="0.8"
                        android:background="@drawable/ygopro_base_background"
                        android:inputType="text"
                        android:singleLine="true"
                        android:imeOptions="actionSearch"
                        android:paddingStart="4dp"
                        android:textColor="@color/white"
                        android:textSize="9sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1.5"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_filter_clear"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/button3_bg"
                        android:text="@string/clear_deck"
                        android:textColor="@color/white"
                        android:textSize="8sp" />

                    <Button
                        android:id="@+id/btn_filter_search"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="2dp"
                        android:layout_weight="2"
                        android:background="@drawable/button3_bg"
                        android:text="@string/search"
                        android:textColor="@color/white"
                        android:textSize="8sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- 副卡组 按钮面板 -->
        <LinearLayout
            android:id="@+id/ll_side_controller"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.4"
            android:gravity="center_vertical"
            android:visibility="gone"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="3">

                <Button
                    android:id="@+id/btn_side_finish"
                    android:layout_width="270dp"
                    android:layout_height="30dp"
                    android:layout_marginHorizontal="2dp"
                    android:layout_gravity="left|center"
                    android:background="@drawable/button3_bg"
                    android:text="副卡组替换完成"
                    android:textSize="10sp" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_side_shuffle"
                    android:layout_width="85dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/button3_bg"
                    android:text="@string/unsort"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/btn_side_sort"
                    android:layout_width="85dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="5dp"
                    android:background="@drawable/button3_bg"
                    android:text="@string/sort"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/btn_side_reset"
                    android:layout_width="85dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/button3_bg"
                    android:text="@string/reset"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ================= 主体区域：卡组网格 + 搜索结果 ================= -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="2dp"
        android:layout_weight="0.75"
        android:orientation="horizontal">

        <!-- 左侧：卡组网格区域 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.7"
            android:orientation="vertical">

            <!-- 主卡组统计行 -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="15dp"
                android:layout_marginVertical="1dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:paddingHorizontal="8dp"
                    android:background="@drawable/ygopro_deck_background"
                    android:layout_gravity="left|center"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_label_main_deck"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="主卡组:"
                        android:textColor="@color/white"
                        android:textSize="8sp" />

                    <TextView
                        android:id="@+id/tv_main_count_num"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="60"
                        android:textColor="@color/white"
                        android:textSize="8sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_genesys_scoreboard"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:paddingHorizontal="8dp"
                    android:background="@drawable/btn_sci_fi_bg"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_label_credit_limit"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_gravity="center"
                        android:layout_marginStart="1dp"
                        android:layout_marginEnd="1dp"
                        android:background="@drawable/radius_background"
                        android:gravity="center"
                        android:text="限"
                        android:textColor="@color/black"
                        android:textSize="6sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_credit_limit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginStart="1dp"
                        android:layout_marginEnd="1dp"
                        android:background="@drawable/button_radius_black_transparents"
                        android:gravity="center"
                        android:text="\?\?\?"
                        android:textColor="@color/white"
                        android:textSize="8sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_label_credit_count"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_gravity="center"
                        android:layout_marginStart="1dp"
                        android:layout_marginEnd="1dp"
                        android:background="@drawable/radius_background"
                        android:gravity="center"
                        android:text="计"
                        android:textColor="@color/black"
                        android:textSize="6sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_credit_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginStart="1dp"
                        android:layout_marginEnd="1dp"
                        android:background="@drawable/button_radius_black_transparents"
                        android:gravity="center"
                        android:text="\?\?\?"
                        android:textColor="@color/white"
                        android:textSize="8sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_label_credit_remain"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_gravity="center"
                        android:layout_marginStart="1dp"
                        android:layout_marginEnd="1dp"
                        android:background="@drawable/radius_background"
                        android:gravity="center"
                        android:text="余"
                        android:textColor="@color/black"
                        android:textSize="6sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_credit_remain"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginStart="1dp"
                        android:layout_marginEnd="1dp"
                        android:background="@drawable/button_radius_black_transparents"
                        android:gravity="center"
                        android:text="\?\?\?"
                        android:textColor="@color/white"
                        android:textSize="8sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_label_genesys"
                        android:layout_width="wrap_content"
                        android:layout_height="10dp"
                        android:layout_gravity="center"
                        android:layout_marginStart="1dp"
                        android:layout_marginEnd="1dp"
                        android:background="@drawable/selected"
                        android:gravity="center"
                        android:text="  GENESYS  "
                        android:textColor="@color/white"
                        android:textSize="6sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:paddingHorizontal="8dp"
                    android:layout_gravity="right|center"
                    android:gravity="center"
                    android:background="@drawable/ygopro_deck_background">

                    <ImageView
                        android:id="@+id/iv_main_monster_type"
                        android:layout_width="10dp"
                        android:layout_height="12dp"
                        android:scaleType="fitXY" />

                    <TextView
                        android:id="@+id/tv_main_monster_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="3dp"
                        android:text="15"
                        android:textColor="@color/white"
                        android:textSize="8sp" />

                    <ImageView
                        android:id="@+id/iv_main_spell_type"
                        android:layout_width="10dp"
                        android:layout_height="12dp"
                        android:layout_marginStart="10dp"
                        android:scaleType="fitXY" />

                    <TextView
                        android:id="@+id/tv_main_spell_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="3dp"
                        android:text="15"
                        android:textColor="@color/white"
                        android:textSize="8sp" />

                    <ImageView
                        android:id="@+id/iv_main_trap_type"
                        android:layout_width="10dp"
                        android:layout_height="12dp"
                        android:layout_marginStart="10dp"
                        android:scaleType="fitXY" />

                    <TextView
                        android:id="@+id/tv_main_trap_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="3dp"
                        android:text="15"
                        android:textColor="@color/white"
                        android:textSize="8sp" />
                </LinearLayout>
            </FrameLayout>

            <!-- 主卡组网格 -->
            <cn.garymb.ygomobile.ui.widget.CardGroupView
                android:id="@+id/cgv_deck_main"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="4"
                android:background="@drawable/ygopro_deck_background"
                app:line_limit="10"
                app:line_max_count="15"
                app:lines="4" />

            <!-- 额外卡组统计行 -->
            <FrameLayout
                android:id="@+id/layout_extra_stats"
                android:layout_width="match_parent"
                android:layout_height="15dp"
                android:layout_marginVertical="1dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:layout_gravity="left|center"
                    android:paddingHorizontal="8dp"
                    android:background="@drawable/ygopro_deck_background"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_label_extra_deck"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="额外卡组:"
                        android:textColor="@color/white"
                        android:textSize="8sp" />

                    <TextView
                        android:id="@+id/tv_extra_count_num"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="15"
                        android:textColor="@color/white"
                        android:textSize="8sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:paddingHorizontal="8dp"
                    android:layout_gravity="right|center"
                    android:gravity="center"
                    android:background="@drawable/ygopro_deck_background">

                    <ImageView
                        android:id="@+id/iv_extra_fusion_type"
                        android:layout_width="10dp"
                        android:layout_height="12dp"
                        android:scaleType="fitXY" />

                    <TextView
                        android:id="@+id/tv_extra_fusion_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="3dp"
                        android:text="15"
                        android:textColor="@color/white"
                        android:textSize="8sp" />

                    <ImageView
                        android:id="@+id/iv_extra_synchro_type"
                        android:layout_width="10dp"
                        android:layout_height="12dp"
                        android:layout_marginStart="10dp"
                        android:scaleType="fitXY" />

                    <TextView
                        android:id="@+id/tv_extra_synchro_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="3dp"
                        android:text="15"
                        android:textColor="@color/white"
                        android:textSize="8sp" />

                    <ImageView
                        android:id="@+id/iv_extra_xyz_type"
                        android:layout_width="10dp"
                        android:layout_height="12dp"
                        android:layout_marginStart="10dp"
                        android:scaleType="fitXY" />

                    <TextView
                        android:id="@+id/tv_extra_xyz_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="3dp"
                        android:text="15"
                        android:textColor="@color/white"
                        android:textSize="8sp" />

                    <ImageView
                        android:id="@+id/iv_extra_link_type"
                        android:layout_width="10dp"
                        android:layout_height="12dp"
                        android:layout_marginStart="10dp"
                        android:scaleType="fitXY" />

                    <TextView
                        android:id="@+id/tv_extra_link_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="3dp"
                        android:text="15"
                        android:textColor="@color/white"
                        android:textSize="8sp" />
                </LinearLayout>
            </FrameLayout>

            <!-- 额外卡组网格 -->
            <cn.garymb.ygomobile.ui.widget.CardGroupView
                android:id="@+id/cgv_deck_extra"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/ygopro_deck_background"
                app:line_limit="10"
                app:line_max_count="15"
                app:lines="1" />

            <!-- 副卡组统计行 -->
            <FrameLayout
                android:id="@+id/layout_side_stats"
                android:layout_width="match_parent"
                android:layout_height="15dp"
                android:layout_marginVertical="1dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_gravity="left|center"
                    android:gravity="center"
                    android:paddingHorizontal="8dp"
                    android:background="@drawable/ygopro_deck_background"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_label_side_deck"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="副卡组:"
                        android:textColor="@color/white"
                        android:textSize="8sp" />

                    <TextView
                        android:id="@+id/tv_side_count_num"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="15"
                        android:textColor="@color/white"
                        android:textSize="8sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:layout_gravity="right|center"
                    android:gravity="center"
                    android:paddingHorizontal="8dp"
                    android:background="@drawable/ygopro_deck_background">

                    <ImageView
                        android:id="@+id/iv_side_monster_type"
                        android:layout_width="10dp"
                        android:layout_height="12dp"
                        android:scaleType="fitXY" />

                    <TextView
                        android:id="@+id/tv_side_monster_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="3dp"
                        android:text="15"
                        android:textColor="@color/white"
                        android:textSize="8sp" />

                    <ImageView
                        android:id="@+id/iv_side_spell_type"
                        android:layout_width="10dp"
                        android:layout_height="12dp"
                        android:layout_marginStart="10dp"
                        android:scaleType="fitXY" />

                    <TextView
                        android:id="@+id/tv_side_spell_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="3dp"
                        android:text="15"
                        android:textColor="@color/white"
                        android:textSize="8sp" />

                    <ImageView
                        android:id="@+id/iv_side_trap_type"
                        android:layout_width="10dp"
                        android:layout_height="12dp"
                        android:layout_marginStart="10dp"
                        android:scaleType="fitXY" />

                    <TextView
                        android:id="@+id/tv_side_trap_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="3dp"
                        android:text="15"
                        android:textColor="@color/white"
                        android:textSize="8sp" />
                </LinearLayout>
            </FrameLayout>

            <!-- 副卡组网格 -->
            <cn.garymb.ygomobile.ui.widget.CardGroupView
                android:id="@+id/cgv_deck_side"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/ygopro_deck_background"
                app:line_limit="10"
                app:line_max_count="15"
                app:lines="1" />
        </LinearLayout>

        <!-- 右侧：搜索结果 -->
        <LinearLayout
            android:id="@+id/layout_deck_right_panel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:layout_weight="0.3"
            android:orientation="vertical">

            <!-- 搜索结果标题 + 排序 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="15dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_deck_search_result"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/ygopro_deck_background"
                    android:gravity="center|left"
                    android:text="搜索结果: 0"
                    android:textColor="@color/white"
                    android:textSize="8sp" />

                <Spinner
                    android:id="@+id/spinner_sort_type"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="2dp"
                    android:layout_weight="1"
                    android:background="@drawable/ygopro_spinner" />
            </LinearLayout>

            <!-- 搜索结果列表 -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_deck_search_results"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="2dp"
                android:background="@drawable/ygopro_deck_background" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>