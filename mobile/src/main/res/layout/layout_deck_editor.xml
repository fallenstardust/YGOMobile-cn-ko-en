<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layout_deck_editor_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000814"
    android:orientation="horizontal">

    <!-- 左侧面板：卡片预览 + 操作按钮 -->
    <LinearLayout
        android:id="@+id/layout_deck_left_panel"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.22"
        android:orientation="vertical"
        android:padding="2dp">

        <!-- 卡片预览区（蓝色边框） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.55"
            android:background="@drawable/panel_sci_fi_bg"
            android:orientation="vertical"
            android:padding="3dp">

            <ImageView
                android:id="@+id/iv_deck_card_image"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="0.6"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:src="@drawable/unknown" />

            <TextView
                android:id="@+id/tv_deck_card_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="2dp"
                android:text="Unknown[0]"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_deck_card_attr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="[怪兽|效果] 种族/属性"
                android:textColor="@color/holo_green_bright"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/tv_deck_card_level"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="[★1] 0/0"
                android:textColor="@color/yellow"
                android:textSize="9sp" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="0.4">

                <TextView
                    android:id="@+id/tv_deck_card_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="选择卡片查看详情"
                    android:textColor="@color/white"
                    android:textSize="9sp" />
            </ScrollView>
        </LinearLayout>

        <!-- 操作按钮区 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.45"
            android:orientation="horizontal"
            android:paddingTop="4dp">

            <!-- 左侧功能按钮列 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.7"
                android:orientation="vertical">

                <Button
                    android:id="@+id/btn_deck_exit"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginBottom="2dp"
                    android:layout_weight="1"
                    android:background="@drawable/button3_bg"
                    android:text="退出编辑"
                    android:textColor="@color/white"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/btn_deck_shuffle"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginBottom="2dp"
                    android:layout_weight="1"
                    android:background="@drawable/button3_bg"
                    android:text="打乱"
                    android:textColor="@color/white"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/btn_deck_sort"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginBottom="2dp"
                    android:layout_weight="1"
                    android:background="@drawable/button3_bg"
                    android:text="排序"
                    android:textColor="@color/white"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/btn_deck_clear"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginBottom="2dp"
                    android:layout_weight="1"
                    android:background="@drawable/button3_bg"
                    android:text="清空"
                    android:textColor="@color/white"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/btn_deck_delete"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/button3_bg"
                    android:text="删除"
                    android:textColor="@color/white"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- 右侧图标按钮列 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="3dp"
                android:layout_weight="0.3"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/btn_deck_settings"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginBottom="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_sci_fi_bg"
                    android:padding="6dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/setting" />

                <ImageButton
                    android:id="@+id/btn_deck_note"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginBottom="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_sci_fi_bg"
                    android:padding="6dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_note" />

                <ImageButton
                    android:id="@+id/btn_deck_sound"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_sci_fi_bg"
                    android:padding="6dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_volume_on" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- 中央区域：卡组管理 -->
    <LinearLayout
        android:id="@+id/layout_deck_center"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.58"
        android:orientation="vertical"
        android:padding="2dp">

        <!-- 顶部：卡组名称 + 保存按钮 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Spinner
                android:id="@+id/spinner_deck_category"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="0.25"
                android:background="@drawable/button3_bg" />

            <Spinner
                android:id="@+id/spinner_deck_list"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_marginStart="3dp"
                android:layout_weight="0.35"
                android:background="@drawable/button3_bg" />

            <Button
                android:id="@+id/btn_deck_save"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_marginStart="3dp"
                android:layout_weight="0.15"
                android:background="@drawable/button3_bg"
                android:text="保存"
                android:textColor="@color/white"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btn_deck_save_as"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_marginStart="3dp"
                android:layout_weight="0.15"
                android:background="@drawable/button3_bg"
                android:text="另存"
                android:textColor="@color/white"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 筛选条件行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Spinner
                android:id="@+id/spinner_filter_type"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_weight="1"
                android:background="@drawable/button3_bg" />

            <Spinner
                android:id="@+id/spinner_filter_type2"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_marginStart="2dp"
                android:layout_weight="1"
                android:background="@drawable/button3_bg" />

            <Spinner
                android:id="@+id/spinner_filter_attribute"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_marginStart="2dp"
                android:layout_weight="1"
                android:background="@drawable/button3_bg" />

            <Spinner
                android:id="@+id/spinner_filter_race"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_marginStart="2dp"
                android:layout_weight="1"
                android:background="@drawable/button3_bg" />

            <Spinner
                android:id="@+id/spinner_filter_limit"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_marginStart="2dp"
                android:layout_weight="1"
                android:background="@drawable/button3_bg" />

            <Button
                android:id="@+id/btn_filter_effect"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_marginStart="2dp"
                android:layout_weight="0.8"
                android:background="@drawable/button3_bg"
                android:text="效果"
                android:textColor="@color/white"
                android:textSize="9sp" />
        </LinearLayout>

        <!-- 第二行筛选：攻击/守备/星数/刻度/关键字 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/et_filter_attack"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_weight="1"
                android:background="@drawable/button3_bg"
                android:hint="攻击"
                android:inputType="text"
                android:paddingStart="4dp"
                android:textColor="@color/white"
                android:textColorHint="#888888"
                android:textSize="9sp" />

            <EditText
                android:id="@+id/et_filter_defense"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_marginStart="2dp"
                android:layout_weight="1"
                android:background="@drawable/button3_bg"
                android:hint="守备"
                android:inputType="text"
                android:paddingStart="4dp"
                android:textColor="@color/white"
                android:textColorHint="#888888"
                android:textSize="9sp" />

            <EditText
                android:id="@+id/et_filter_star"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_marginStart="2dp"
                android:layout_weight="1"
                android:background="@drawable/button3_bg"
                android:hint="星数"
                android:inputType="text"
                android:paddingStart="4dp"
                android:textColor="@color/white"
                android:textColorHint="#888888"
                android:textSize="9sp" />

            <EditText
                android:id="@+id/et_filter_scale"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_marginStart="2dp"
                android:layout_weight="1"
                android:background="@drawable/button3_bg"
                android:hint="刻度"
                android:inputType="text"
                android:paddingStart="4dp"
                android:textColor="@color/white"
                android:textColorHint="#888888"
                android:textSize="9sp" />

            <EditText
                android:id="@+id/et_filter_keyword"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_marginStart="2dp"
                android:layout_weight="1.5"
                android:background="@drawable/button3_bg"
                android:hint="关键字"
                android:inputType="text"
                android:paddingStart="4dp"
                android:textColor="@color/white"
                android:textColorHint="#888888"
                android:textSize="9sp" />
        </LinearLayout>

        <!-- 统计信息行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_deck_main_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="主卡组: 0"
                android:textColor="#FF8800"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_deck_extra_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="额外卡组: 0"
                android:textColor="#00CC66"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_deck_side_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="副卡组: 0"
                android:textColor="#FF66AA"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 主卡组网格 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="主卡组"
            android:textColor="#FF8800"
            android:textSize="9sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_deck_main"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.5"
            android:background="#20FFFFFF" />

        <!-- 额外卡组网格 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="额外卡组"
            android:textColor="#00CC66"
            android:textSize="9sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_deck_extra"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.22"
            android:background="#20FFFFFF" />

        <!-- 副卡组网格 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="副卡组"
            android:textColor="#FF66AA"
            android:textSize="9sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_deck_side"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.22"
            android:background="#20FFFFFF" />
    </LinearLayout>

    <!-- 右侧面板：搜索结果 -->
    <LinearLayout
        android:id="@+id/layout_deck_right_panel"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.20"
        android:orientation="vertical"
        android:padding="2dp">

        <!-- 搜索结果标题 + 排序 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_deck_search_result"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="搜索结果: 0"
                android:textColor="@color/white"
                android:textSize="10sp" />

            <Spinner
                android:id="@+id/spinner_sort_type"
                android:layout_width="0dp"
                android:layout_height="26dp"
                android:layout_weight="1"
                android:background="@drawable/button3_bg" />
        </LinearLayout>

        <!-- 搜索结果列表 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_deck_search_results"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="3dp"
            android:layout_weight="1"
            android:background="#20FFFFFF" />
    </LinearLayout>
</LinearLayout>