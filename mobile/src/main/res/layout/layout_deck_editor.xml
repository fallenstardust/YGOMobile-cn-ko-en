<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_deck_editor_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000814"
    android:orientation="horizontal">

    <!-- 中央区域：卡组管理 -->
    <LinearLayout
        android:id="@+id/layout_deck_center"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.58"
        android:orientation="vertical"
        android:padding="2dp">

        <!-- 顶部：卡组名称 + 保存按钮 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Spinner
                android:id="@+id/spinner_deck_category"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="0.25"
                android:background="@drawable/button3_bg" />

            <Spinner
                android:id="@+id/spinner_deck_list"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_marginStart="3dp"
                android:layout_weight="0.35"
                android:background="@drawable/button3_bg" />

            <Button
                android:id="@+id/btn_deck_save"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_marginStart="3dp"
                android:layout_weight="0.15"
                android:background="@drawable/button3_bg"
                android:text="保存"
                android:textColor="@color/white"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btn_deck_save_as"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_marginStart="3dp"
                android:layout_weight="0.15"
                android:background="@drawable/button3_bg"
                android:text="另存"
                android:textColor="@color/white"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 筛选条件行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Spinner
                android:id="@+id/spinner_filter_type"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_weight="1"
                android:background="@drawable/button3_bg" />

            <Spinner
                android:id="@+id/spinner_filter_type2"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_marginStart="2dp"
                android:layout_weight="1"
                android:background="@drawable/button3_bg" />

            <Spinner
                android:id="@+id/spinner_filter_attribute"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_marginStart="2dp"
                android:layout_weight="1"
                android:background="@drawable/button3_bg" />

            <Spinner
                android:id="@+id/spinner_filter_race"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_marginStart="2dp"
                android:layout_weight="1"
                android:background="@drawable/button3_bg" />

            <Spinner
                android:id="@+id/spinner_filter_limit"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_marginStart="2dp"
                android:layout_weight="1"
                android:background="@drawable/button3_bg" />

            <Button
                android:id="@+id/btn_filter_effect"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_marginStart="2dp"
                android:layout_weight="0.8"
                android:background="@drawable/button3_bg"
                android:text="效果"
                android:textColor="@color/white"
                android:textSize="9sp" />
        </LinearLayout>

        <!-- 第二行筛选：攻击/守备/星数/刻度/关键字 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/et_filter_attack"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_weight="1"
                android:background="@drawable/button3_bg"
                android:hint="攻击"
                android:inputType="text"
                android:paddingStart="4dp"
                android:textColor="@color/white"
                android:textColorHint="#888888"
                android:textSize="9sp" />

            <EditText
                android:id="@+id/et_filter_defense"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_marginStart="2dp"
                android:layout_weight="1"
                android:background="@drawable/button3_bg"
                android:hint="守备"
                android:inputType="text"
                android:paddingStart="4dp"
                android:textColor="@color/white"
                android:textColorHint="#888888"
                android:textSize="9sp" />

            <EditText
                android:id="@+id/et_filter_star"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_marginStart="2dp"
                android:layout_weight="1"
                android:background="@drawable/button3_bg"
                android:hint="星数"
                android:inputType="text"
                android:paddingStart="4dp"
                android:textColor="@color/white"
                android:textColorHint="#888888"
                android:textSize="9sp" />

            <EditText
                android:id="@+id/et_filter_scale"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_marginStart="2dp"
                android:layout_weight="1"
                android:background="@drawable/button3_bg"
                android:hint="刻度"
                android:inputType="text"
                android:paddingStart="4dp"
                android:textColor="@color/white"
                android:textColorHint="#888888"
                android:textSize="9sp" />

            <EditText
                android:id="@+id/et_filter_keyword"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_marginStart="2dp"
                android:layout_weight="1.5"
                android:background="@drawable/button3_bg"
                android:hint="关键字"
                android:inputType="text"
                android:paddingStart="4dp"
                android:textColor="@color/white"
                android:textColorHint="#888888"
                android:textSize="9sp" />
        </LinearLayout>

        <!-- 统计信息行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_deck_main_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="主卡组: 0"
                android:textColor="#FF8800"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_deck_extra_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="额外卡组: 0"
                android:textColor="#00CC66"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_deck_side_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="副卡组: 0"
                android:textColor="#FF66AA"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 主卡组网格 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="主卡组"
            android:textColor="#FF8800"
            android:textSize="9sp" />

        <cn.garymb.ygomobile.ui.widget.CardGroupView
            android:id="@+id/cgv_deck_main"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.5"
            android:background="#20FFFFFF"
            app:lines="4"
            app:line_limit="10"
            app:line_max_count="15" />

        <!-- 额外卡组网格 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="额外卡组"
            android:textColor="#00CC66"
            android:textSize="9sp" />

        <cn.garymb.ygomobile.ui.widget.CardGroupView
            android:id="@+id/cgv_deck_extra"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.22"
            android:background="#20FFFFFF"
            app:lines="1"
            app:line_limit="10"
            app:line_max_count="15" />

        <!-- 副卡组网格 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="副卡组"
            android:textColor="#FF66AA"
            android:textSize="9sp" />

        <cn.garymb.ygomobile.ui.widget.CardGroupView
            android:id="@+id/cgv_deck_side"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.22"
            android:background="#20FFFFFF"
            app:lines="1"
            app:line_limit="10"
            app:line_max_count="15" />
    </LinearLayout>

    <!-- 右侧面板：搜索结果 -->
    <LinearLayout
        android:id="@+id/layout_deck_right_panel"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.20"
        android:orientation="vertical"
        android:padding="2dp">

        <!-- 搜索结果标题 + 排序 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_deck_search_result"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="搜索结果: 0"
                android:textColor="@color/white"
                android:textSize="10sp" />

            <Spinner
                android:id="@+id/spinner_sort_type"
                android:layout_width="0dp"
                android:layout_height="26dp"
                android:layout_weight="1"
                android:background="@drawable/button3_bg" />
        </LinearLayout>

        <!-- 搜索结果列表 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_deck_search_results"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="3dp"
            android:layout_weight="1"
            android:background="#20FFFFFF" />
    </LinearLayout>
</LinearLayout>