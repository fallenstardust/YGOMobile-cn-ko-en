<?xml version="1.0" encoding="utf-8"?><!--
  持续适用中效果的列表行（用户规格：左边卡片图缩小版，右边效果文字）。
  文字只取携时长语的子句（如「这个回合，…」），字号硬 6sp（用户新规格：显示文字再缩小一档，
  不随 HUD 系数放大，否则长句在窄面板里显示不完）；卡图缩略版按 177:254 原比例，宽高由
  ApplyingEffectsPopup 按 HUD 系数等比设定。整行可点 → 在卡详面板看该卡完整描述与已打勾序号段。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layout_applying_effect_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="2dp"
    android:paddingBottom="2dp">

    <ImageView
        android:id="@+id/iv_applying_effect_card"
        android:layout_width="20dp"
        android:layout_height="29dp"
        android:adjustViewBounds="true"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        android:src="@drawable/unknown" />

    <TextView
        android:id="@+id/tv_applying_effect_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="5dp"
        android:ellipsize="end"
        android:maxLines="3"
        android:textColor="@color/white"
        android:textSize="6sp" />
</LinearLayout>
