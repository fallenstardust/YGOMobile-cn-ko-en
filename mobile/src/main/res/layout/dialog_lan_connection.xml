<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="600dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- 昵称行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:text="昵称："
                android:textColor="#FFFFFF"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/et_nickname"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/selected_light"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#888888"
                android:hint="请输入昵称" />

            <Button
                android:id="@+id/btn_create_host"
                android:layout_width="120dp"
                android:layout_height="40dp"
                android:layout_marginStart="10dp"
                android:text="局域网建主"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:background="@drawable/button2_bg" />
        </LinearLayout>

        <!-- 主机列表区域 -->
        <ListView
            android:id="@+id/lv_host_list"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:background="@drawable/selected_light"
            android:divider="#33FFFFFF"
            android:dividerHeight="1dp"
            android:layout_marginBottom="12dp" />

        <!-- 刷新按钮 -->
        <Button
            android:id="@+id/btn_refresh_lan"
            android:layout_width="120dp"
            android:layout_height="40dp"
            android:layout_gravity="center_horizontal"
            android:text="刷新局域网"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:background="@drawable/button2_bg"
            android:layout_marginBottom="12dp" />

        <!-- 主机信息行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:text="主机信息："
                android:textColor="#FFFFFF"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/et_host_ip"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginEnd="10dp"
                android:background="@drawable/selected_light"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#888888"
                android:hint="IP地址"
                android:inputType="text" />

            <EditText
                android:id="@+id/et_host_port"
                android:layout_width="80dp"
                android:layout_height="40dp"
                android:background="@drawable/selected_light"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#888888"
                android:hint="端口"
                android:inputType="number" />

            <Button
                android:id="@+id/btn_join_game"
                android:layout_width="120dp"
                android:layout_height="40dp"
                android:layout_marginStart="10dp"
                android:text="加入游戏"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:background="@drawable/button2_bg" />
        </LinearLayout>

        <!-- 房间密码行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:text="房间密码："
                android:textColor="#FFFFFF"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/et_room_password"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/selected_light"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#888888"
                android:hint="请输入房间密码（可选）"
                android:inputType="textPassword" />

            <Button
                android:id="@+id/btn_cancel"
                android:layout_width="120dp"
                android:layout_height="40dp"
                android:layout_marginStart="10dp"
                android:text="取消"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:background="@drawable/button2_bg" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
