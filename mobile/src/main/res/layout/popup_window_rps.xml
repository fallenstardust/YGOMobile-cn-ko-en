<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="10dp"
    android:background="@color/ygopro_background_color"
    android:gravity="center_vertical">

    <ImageView
        android:id="@+id/btn_rps_scissors"
        android:layout_width="70dp"
        android:layout_height="90dp"
        android:scaleType="fitCenter"
        android:background="@color/black"
        android:src="@drawable/ic_close_black_24dp"
        android:contentDescription="剪刀" />

    <ImageView
        android:id="@+id/btn_rps_rock"
        android:layout_width="70dp"
        android:layout_height="90dp"
        android:layout_marginHorizontal="10dp"
        android:background="@color/black"
        android:src="@drawable/ic_close_black_24dp"
        android:scaleType="fitCenter"
        android:contentDescription="石头" />

    <ImageView
        android:id="@+id/btn_rps_paper"
        android:layout_width="70dp"
        android:layout_height="90dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_close_black_24dp"
        android:background="@color/black"
        android:contentDescription="布" />
</LinearLayout>