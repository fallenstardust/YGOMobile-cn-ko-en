<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/announce_number_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/sdialogl"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tv_announce_number_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="选择数字"
        android:textColor="@color/white"
        android:textSize="11sp" />

    <Spinner
        android:id="@+id/sp_announce_number"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/ygopro_base_background" />

    <GridLayout
        android:id="@+id/layout_annumber_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:columnCount="3"
        android:rowCount="4">

        <Button
            android:id="@+id/btn_annumber_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_row="0"
            android:layout_column="0"
            android:layout_columnWeight="1"
            android:layout_gravity="fill_horizontal"
            android:layout_margin="2dp"
            android:background="@drawable/button3_bg"
            android:minWidth="0dp"
            android:minHeight="36dp"
            android:padding="4dp"
            android:text="1"
            android:textColor="@color/white"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_annumber_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_row="0"
            android:layout_column="1"
            android:layout_columnWeight="1"
            android:layout_gravity="fill_horizontal"
            android:layout_margin="2dp"
            android:background="@drawable/button3_bg"
            android:minWidth="0dp"
            android:minHeight="36dp"
            android:padding="4dp"
            android:text="2"
            android:textColor="@color/white"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_annumber_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_row="0"
            android:layout_column="2"
            android:layout_columnWeight="1"
            android:layout_gravity="fill_horizontal"
            android:layout_margin="2dp"
            android:background="@drawable/button3_bg"
            android:minWidth="0dp"
            android:minHeight="36dp"
            android:padding="4dp"
            android:text="3"
            android:textColor="@color/white"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_annumber_4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_row="1"
            android:layout_column="0"
            android:layout_columnWeight="1"
            android:layout_gravity="fill_horizontal"
            android:layout_margin="2dp"
            android:background="@drawable/button3_bg"
            android:minWidth="0dp"
            android:minHeight="36dp"
            android:padding="4dp"
            android:text="4"
            android:textColor="@color/white"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_annumber_5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_row="1"
            android:layout_column="1"
            android:layout_columnWeight="1"
            android:layout_gravity="fill_horizontal"
            android:layout_margin="2dp"
            android:background="@drawable/button3_bg"
            android:minWidth="0dp"
            android:minHeight="36dp"
            android:padding="4dp"
            android:text="5"
            android:textColor="@color/white"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_annumber_6"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_row="1"
            android:layout_column="2"
            android:layout_columnWeight="1"
            android:layout_gravity="fill_horizontal"
            android:layout_margin="2dp"
            android:background="@drawable/button3_bg"
            android:minWidth="0dp"
            android:minHeight="36dp"
            android:padding="4dp"
            android:text="6"
            android:textColor="@color/white"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_annumber_7"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_row="2"
            android:layout_column="0"
            android:layout_columnWeight="1"
            android:layout_gravity="fill_horizontal"
            android:layout_margin="2dp"
            android:background="@drawable/button3_bg"
            android:minWidth="0dp"
            android:minHeight="36dp"
            android:padding="4dp"
            android:text="7"
            android:textColor="@color/white"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_annumber_8"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_row="2"
            android:layout_column="1"
            android:layout_columnWeight="1"
            android:layout_gravity="fill_horizontal"
            android:layout_margin="2dp"
            android:background="@drawable/button3_bg"
            android:minWidth="0dp"
            android:minHeight="36dp"
            android:padding="4dp"
            android:text="8"
            android:textColor="@color/white"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_annumber_9"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_row="2"
            android:layout_column="2"
            android:layout_columnWeight="1"
            android:layout_gravity="fill_horizontal"
            android:layout_margin="2dp"
            android:background="@drawable/button3_bg"
            android:minWidth="0dp"
            android:minHeight="36dp"
            android:padding="4dp"
            android:text="9"
            android:textColor="@color/white"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_annumber_10"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_row="3"
            android:layout_column="0"
            android:layout_columnWeight="1"
            android:layout_gravity="fill_horizontal"
            android:layout_margin="2dp"
            android:background="@drawable/button3_bg"
            android:minWidth="0dp"
            android:minHeight="36dp"
            android:padding="4dp"
            android:text="10"
            android:textColor="@color/white"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_annumber_11"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_row="3"
            android:layout_column="1"
            android:layout_columnWeight="1"
            android:layout_gravity="fill_horizontal"
            android:layout_margin="2dp"
            android:background="@drawable/button3_bg"
            android:minWidth="0dp"
            android:minHeight="36dp"
            android:padding="4dp"
            android:text="11"
            android:textColor="@color/white"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_annumber_12"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_row="3"
            android:layout_column="2"
            android:layout_columnWeight="1"
            android:layout_gravity="fill_horizontal"
            android:layout_margin="2dp"
            android:background="@drawable/button3_bg"
            android:minWidth="0dp"
            android:minHeight="36dp"
            android:padding="4dp"
            android:text="12"
            android:textColor="@color/white"
            android:textSize="12sp" />
    </GridLayout>

    <Button
        android:id="@+id/btn_annumber_ok"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="6dp"
        android:background="@drawable/button3_bg"
        android:minWidth="100dp"
        android:minHeight="30dp"
        android:text="@string/ok"
        android:textColor="@color/white"
        android:textSize="10sp" />
</LinearLayout>