<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:background="#E0000000"
    android:orientation="vertical"
    android:minWidth="280dp"
    android:padding="16dp">

    <TextView
        android:id="@+id/tv_select_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="请选择"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/tv_select_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#CCCCCC"
        android:textSize="13sp"
        android:gravity="center"
        android:visibility="gone"
        android:layout_marginBottom="8dp" />

    <!-- 选项列表（用于SelectOption、SelectYesNo等） -->
    <ScrollView
        android:id="@+id/scroll_options"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="300dp">

        <LinearLayout
            android:id="@+id/layout_options"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <!-- 卡片选择区域 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_card_select"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:visibility="gone" />

    <!-- 位置选择区域（怪兽区/魔法区选择） -->
    <GridLayout
        android:id="@+id/grid_place_select"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:columnCount="7"
        android:rowCount="2"
        android:visibility="gone" />

    <!-- 底部按钮 -->
    <LinearLayout
        android:id="@+id/layout_select_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="12dp">

        <Button
            android:id="@+id/btn_select_confirm"
            android:layout_width="100dp"
            android:layout_height="40dp"
            android:text="确认"
            android:background="@android:color/holo_blue_dark"
            android:textColor="@android:color/white"
            android:layout_marginEnd="12dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btn_select_cancel"
            android:layout_width="100dp"
            android:layout_height="40dp"
            android:text="取消"
            android:background="#666666"
            android:textColor="@android:color/white" />
    </LinearLayout>
</LinearLayout>
