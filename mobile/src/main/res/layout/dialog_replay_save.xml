<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/replay_save_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/sdialogl"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="5dp"
        android:layout_weight="0.2"
        android:gravity="center_vertical|start"
        android:text="录像文件:"
        android:textColor="@color/white"
        android:textSize="10sp" />

    <EditText
        android:id="@+id/et_replay_name"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginVertical="5dp"
        android:layout_weight="0.4"
        android:imeOptions="actionDone"
        android:inputType="textNoSuggestions"
        android:singleLine="true"
        android:gravity="center"
        android:textColor="@color/white"
        android:background="@drawable/ygopro_base_background"
        android:textColorHint="@color/gray"
        android:textSize="10sp" />

    <LinearLayout
        android:id="@+id/replay_save_button_area"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.4"
        android:layout_gravity="bottom"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_replay_save"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/button3_bg"
            android:layout_marginEnd="10dp"
            android:minWidth="100dp"
            android:minHeight="30dp"
            android:text="@string/save"
            android:textColor="@color/white"
            android:textSize="10sp" />

        <Button
            android:id="@+id/btn_replay_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/button3_bg"
            android:layout_marginStart="10dp"
            android:minWidth="100dp"
            android:minHeight="30dp"
            android:text="@string/cancel"
            android:textColor="@color/white"
            android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>