<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layout_lan_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="10dp">

        <TextView
            android:layout_width="70dp"
            android:layout_height="wrap_content"
            android:text="昵称："
            android:textColor="@color/white"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/et_nickname"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/selected_light"
            android:paddingHorizontal="10dp"
            android:textColor="@color/white"
            android:textColorHint="#888888"
            android:hint="请输入昵称" />

        <Button
            android:id="@+id/btn_create_host"
            android:layout_width="110dp"
            android:layout_height="40dp"
            android:layout_marginStart="10dp"
            android:text="局域网建主"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:background="@drawable/button3_bg" />
    </LinearLayout>

    <ListView
        android:id="@+id/lv_host_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#0A5C5C"
        android:divider="#33FFFFFF"
        android:dividerHeight="1dp" />

    <Button
        android:id="@+id/btn_refresh_lan"
        android:layout_width="110dp"
        android:layout_height="40dp"
        android:layout_gravity="center_horizontal|bottom"
        android:text="刷新局域网"
        android:textColor="@color/white"
        android:textSize="12sp"
        android:background="@drawable/button3_bg"
        android:layout_marginVertical="5dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_gravity="center_horizontal|bottom"
        android:layout_marginBottom="5dp">

        <TextView
            android:layout_width="70dp"
            android:layout_height="wrap_content"
            android:text="@string/server_ip"
            android:textColor="@color/white"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/et_host_ip"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="@drawable/selected_light"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:textColor="@color/white"
            android:textColorHint="#888888"
            android:hint="IP/域名地址"
            android:inputType="text" />

        <EditText
            android:id="@+id/et_host_port"
            android:layout_width="70dp"
            android:layout_height="40dp"
            android:background="@drawable/selected_light"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:textColor="@color/white"
            android:textColorHint="#888888"
            android:hint="端口"
            android:inputType="number" />

        <Button
            android:id="@+id/btn_join_game"
            android:layout_width="110dp"
            android:layout_height="40dp"
            android:layout_marginStart="10dp"
            android:text="@string/join_game"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:background="@drawable/button3_bg" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_gravity="center_horizontal|bottom">

        <TextView
            android:layout_width="70dp"
            android:layout_height="wrap_content"
            android:text="@string/server_room_pwd"
            android:textColor="@color/white"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/et_room_password"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/selected_light"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:textColor="@color/white"
            android:textColorHint="#888888"
            android:hint="请输入房间密码（可选）"
            android:inputType="textPassword" />

        <Button
            android:id="@+id/btn_exit_lan"
            android:layout_width="110dp"
            android:layout_height="40dp"
            android:layout_marginStart="10dp"
            android:text="@string/quit"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:background="@drawable/button3_bg" />
    </LinearLayout>

</LinearLayout>