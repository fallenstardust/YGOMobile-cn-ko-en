<?xml version="1.0" encoding="utf-8"?><!-- 右侧区域（层叠结构）：决斗场区域底层铺满，顶部玩家信息区锚定 top，聊天输入框锚定 bottom -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_game_right"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false">

    <!-- 决斗场区域：GameFieldView 3D 渲染（场地/区域/场上卡/堆叠区/双方手卡） -->
    <!-- 以下参数可在 XML 中直接调整，设计预览与运行期同步生效（详见 attrs.xml GameFieldView） -->
    <cn.garymb.ygomobile.render.GameFieldView
        android:id="@+id/game_field_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:field_camera_elevation="52"
        app:field_camera_distance="7.6"
        app:field_zoom="1.0"
        app:field_hand_shift="0"
        app:field_preview_zones="true"
        app:field_preview_hand="true"
        app:field_preview_labels="true" />

    <!-- GameTopInfo区域（最上层） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:orientation="vertical">

        <!-- 顶部玩家信息区（常驻显示，悬浮于决斗场区域上方） -->
        <LinearLayout
            android:id="@+id/layout_top_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:orientation="horizontal">

            <!-- 我方信息面板（左上）：底层头像框+血条框（lpbarf 拆分为头像框/血条框两部分，
                 头像框单独适配头像尺寸、血条框自由拉伸），顶层名字/总卡数/倒计时 -->
            <FrameLayout
                android:id="@+id/layout_player_panel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="5">

                <!-- 底层：头像框 + 血条框 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- 头像框容器：头像贴图 + 叠加其上的头像框（lpbarf 行首 64px 镂空框），
                         容器尺寸由 GameTopInfoManager 按面板高度与 64:70 比例设定 -->
                    <FrameLayout
                        android:id="@+id/layout_player_avatar_box"
                        android:layout_width="50dp"
                        android:layout_height="match_parent">

                        <ImageView
                            android:id="@+id/iv_player_avatar"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="4dp"
                            android:scaleType="fitXY"
                            android:src="@drawable/avatar" />

                        <ImageView
                            android:id="@+id/iv_player_avatar_frame"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="fitXY" />
                    </FrameLayout>

                    <!-- 血条框容器：LP 血条填充 + 叠加其上的血条框（lpbarf 行尾 241px 中段，自由拉伸）。
                         LP 血条（drawing.cpp L936-973 tLPBar，我方自左向右填充；每 8000 一节，超出部分叠加下一节颜色层） -->
                    <FrameLayout
                        android:id="@+id/layout_player_bar_box"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1">

                        <ImageView
                            android:id="@+id/iv_player_lp_bar"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginVertical="4dp"
                            android:layout_marginStart="2dp"
                            android:layout_marginEnd="4dp"
                            android:scaleType="fitXY"
                            android:src="@drawable/ygopro_selected_background" />

                        <ImageView
                            android:id="@+id/iv_player_lp_bar_layer"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginVertical="4dp"
                            android:layout_marginStart="2dp"
                            android:layout_marginEnd="4dp"
                            android:scaleType="fitXY"
                            android:visibility="gone" />

                        <ImageView
                            android:id="@+id/iv_player_bar_frame"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="fitXY" />
                    </FrameLayout>
                </LinearLayout>

                <!-- 顶层：玩家名字 / 总卡数 / 回合倒计时（paddingStart 由 Java 随头像框宽同步） -->
                <LinearLayout
                    android:id="@+id/layout_player_info_col"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:paddingStart="50dp"
                    android:paddingEnd="5dp">

                    <TextView
                        android:id="@+id/tv_player_name"
                        android:layout_width="wrap_content"
                        android:layout_height="0dp"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:maxLines="1"
                        android:shadowColor="@color/black"
                        android:shadowDx="0"
                        android:shadowDy="0"
                        android:shadowRadius="4"
                        android:text="Knight of Hanoi"
                        android:textColor="@color/white"
                        android:textSize="10sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_player_lp_number"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:maxLines="1"
                            android:shadowColor="@color/black"
                            android:shadowDx="2"
                            android:shadowDy="2"
                            android:shadowRadius="1"
                            android:text="8000"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="right|center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/iv_player_card_back"
                                android:layout_width="wrap_content"
                                android:layout_height="10sp"
                                android:adjustViewBounds="true"
                                android:scaleType="fitXY"
                                android:src="@drawable/unknown" />

                            <TextView
                                android:id="@+id/tv_player_card_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="2dp"
                                android:gravity="center_vertical"
                                android:text="0"
                                android:textColor="#FFFFFF"
                                android:textSize="10sp" />

                            <TextView
                                android:id="@+id/tv_player_time"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginHorizontal="5dp"
                                android:gravity="center_vertical"
                                android:text="0"
                                android:textColor="#FFFFFF"
                                android:textSize="10sp"
                                android:visibility="visible" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

            <!-- 中央回合计数器：外层 FrameLayout 承接行内权重 1 与 veil_mid_vertical 背景，
                 撤回提示图标叠加在回合数字下方（闪动发光 = 当前有可整段回退的动作） -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="2dp"
                android:layout_weight="1"
                android:background="@drawable/veil_mid_vertical"
                android:clipChildren="false">

                <TextView
                    android:id="@+id/tv_turn_counter"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:shadowColor="@color/white"
                    android:shadowDx="-2"
                    android:shadowDy="-1"
                    android:shadowRadius="1"
                    android:text="99"
                    android:textColor="@color/ygopro_list_background"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <!-- 局域网撤回入口：平时 invisible，收到 STOC_UNDO_STATE=1 时由
                     GameTopInfoManager.setUndoPrompt 点亮并呼吸式闪动发光 -->
                <ImageView
                    android:id="@+id/iv_undo"
                    android:layout_width="26dp"
                    android:layout_height="20dp"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="1dp"
                    android:background="@drawable/undo_glow"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="5dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_undo"
                    android:visibility="invisible" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/layout_opponent_panel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="5">

                <!-- 底层：血条框 + 头像框（镜像我方：血条框在左、头像框在右） -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- 血条框容器：LP 血条填充 + 叠加其上的血条框（lpbarf 行首 241px 中段，自由拉伸）。
                         LP 血条（drawing.cpp L936-973 tLPBar，对方自右向左填充；每 8000 一节，超出部分叠加下一节颜色层） -->
                    <FrameLayout
                        android:id="@+id/layout_opponent_bar_box"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1">

                        <ImageView
                            android:id="@+id/iv_opponent_lp_bar"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginVertical="4dp"
                            android:layout_marginStart="4dp"
                            android:layout_marginEnd="2dp"
                            android:scaleType="fitXY"
                            android:src="@drawable/ygopro_selected_background" />

                        <ImageView
                            android:id="@+id/iv_opponent_lp_bar_layer"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginVertical="4dp"
                            android:layout_marginStart="4dp"
                            android:layout_marginEnd="2dp"
                            android:scaleType="fitXY"
                            android:visibility="gone" />

                        <ImageView
                            android:id="@+id/iv_opponent_bar_frame"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="fitXY" />
                    </FrameLayout>

                    <!-- 头像框容器：头像贴图 + 叠加其上的头像框（lpbarf 行尾 64px 镂空框） -->
                    <FrameLayout
                        android:id="@+id/layout_opponent_avatar_box"
                        android:layout_width="50dp"
                        android:layout_height="match_parent">

                        <ImageView
                            android:id="@+id/iv_opponent_avatar"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="4dp"
                            android:scaleType="fitXY"
                            android:src="@drawable/avatar" />

                        <ImageView
                            android:id="@+id/iv_opponent_avatar_frame"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="fitXY" />
                    </FrameLayout>
                </LinearLayout>

                <!-- 顶层：玩家名字 / 总卡数 / 回合倒计时（镜像我方：名字靠右，第二行左对齐 倒计时/总卡数/卡背图标；paddingEnd 由 Java 随头像框宽同步） -->
                <LinearLayout
                    android:id="@+id/layout_opponent_info_col"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:paddingStart="5dp"
                    android:paddingEnd="50dp">

                    <TextView
                        android:id="@+id/tv_opponent_name"
                        android:layout_width="wrap_content"
                        android:layout_height="0dp"
                        android:layout_gravity="end"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:maxLines="1"
                        android:shadowColor="@color/black"
                        android:shadowDx="0"
                        android:shadowDy="0"
                        android:shadowRadius="4"
                        android:text="Opponent"
                        android:textColor="@color/white"
                        android:textSize="10sp" />

                    <!-- 第二行（镜像我方）：LP 数字居中，倒计时/总卡数/卡背图标靠左 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="left|center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tv_opponent_time"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginHorizontal="5dp"
                                android:gravity="center_vertical"
                                android:text="0"
                                android:textColor="@color/white"
                                android:textSize="10sp"
                                android:visibility="visible" />

                            <ImageView
                                android:id="@+id/iv_opponent_card_back"
                                android:layout_width="wrap_content"
                                android:layout_height="10sp"
                                android:adjustViewBounds="true"
                                android:scaleType="fitXY"
                                android:src="@drawable/unknown" />

                            <TextView
                                android:id="@+id/tv_opponent_card_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="2dp"
                                android:gravity="center_vertical"
                                android:text="0"
                                android:textColor="@color/white"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_opponent_lp_number"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:maxLines="1"
                            android:shadowColor="@color/black"
                            android:shadowDx="2"
                            android:shadowDy="2"
                            android:shadowRadius="1"
                            android:text="8000"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <!-- 聊天消息区域 -->
        <FrameLayout
            android:id="@+id/layout_chat_messages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center|top"
            android:orientation="horizontal"
            android:visibility="visible">

            <TextView
                android:id="@+id/tv_chat_message_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:layout_marginStart="50dp"
                android:maxLines="5"
                android:ellipsize="end"
                android:background="#A0000000"
                android:textColor="@color/white"
                android:textSize="9sp"
                android:visibility="gone" />

            <!-- 提示信息 -->
            <TextView
                android:id="@+id/tv_hint_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center|top"
                android:background="@color/colorNavy"
                android:text="请选择要特殊召唤的怪兽（9-9）"
                android:textColor="@color/white"
                android:textSize="9sp"
                android:visibility="invisible" />

            <TextView
                android:id="@+id/tv_chat_message_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:background="#A0000000"
                android:layout_marginEnd="50dp"
                android:maxLines="5"
                android:ellipsize="end"
                android:textColor="@color/white"
                android:textSize="9sp"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <!-- 系统/观战消息弹幕回退层（仅供 drawspec 覆盖层不可用时兜底；正常弹幕宿主是
         SpecEffectOverlay PopupWindow 层贴屏幕顶部的全屏横带，最多 3 行，不受 GL 曲面遮挡。
         本层在 GameFieldView(setZOrderOnTop) 之下，叠在其上仅作历史保留，对齐 drawing.cpp DrawChatMsg） -->
    <FrameLayout
        android:id="@+id/layout_danmaku"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:clipChildren="false" />

    <!-- 表情气泡（对齐 gframe drawing.cpp DrawEmoticon）：收到表情聊天时显示在发送方头像下方，由 GameFieldController 定时自动隐藏 -->
    <ImageView
        android:id="@+id/iv_player_emote_bubble"
        android:layout_width="44dp"
        android:layout_height="52dp"
        android:layout_gravity="start|top"
        android:layout_marginStart="3dp"
        android:layout_marginTop="50dp"
        android:background="@drawable/bg_emote_bubble"
        android:contentDescription="@null"
        android:paddingStart="3dp"
        android:paddingTop="11dp"
        android:paddingEnd="3dp"
        android:paddingBottom="3dp"
        android:scaleType="fitCenter"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/iv_opponent_emote_bubble"
        android:layout_width="44dp"
        android:layout_height="52dp"
        android:layout_gravity="end|top"
        android:layout_marginEnd="3dp"
        android:layout_marginTop="50dp"
        android:background="@drawable/bg_emote_bubble"
        android:contentDescription="@null"
        android:paddingStart="3dp"
        android:paddingTop="11dp"
        android:paddingEnd="3dp"
        android:paddingBottom="3dp"
        android:scaleType="fitCenter"
        android:visibility="gone" />

    <!-- 聊天输入框（悬浮于决斗场区域底部） -->
    <EditText
        android:id="@+id/et_chat_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/ygopro_base_background"
        android:imeOptions="actionSend|flagNoExtractUi"
        android:inputType="text"
        android:maxLines="1"
        android:textColor="@color/white"
        android:textSize="9sp" />
</FrameLayout>
