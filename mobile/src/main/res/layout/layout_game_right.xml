<?xml version="1.0" encoding="utf-8"?><!-- 右侧区域（层叠结构）：决斗场区域底层铺满，顶部玩家信息区锚定 top，聊天输入框锚定 bottom -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_game_right"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <!-- 六按钮列：显式声明 wrap 宽度，确保在水平行内占据最左侧列宽，聊天输入框据其余宽度排布于其右 -->
    <include
        layout="@layout/layout_image_buttons_panel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"/>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false">

        <!-- 决斗场区域：GameFieldView 3D 渲染（场地/区域/场上卡/堆叠区/双方手卡） -->
        <!-- 决斗场微调参数图例（可在 XML 直接调整，设计预览与运行期同步生效；详见 attrs.xml GameFieldView）：
             注：XML 标签内部不允许逐行内联注释，故各属性语义集中列于此，一行对应下方一行 app:
             field_camera_elevation = 倾斜度：相机俯仰角 35~75°，越大越接近正俯视
             field_camera_distance  = 摄像头距离：视点到注视点距离，越大透视越平、对方侧越显大
             field_zoom             = 等比总缩放：横竖同一基准缩放决斗场，1.0=近端左右贴视图缘
             field_width            = 宽度：横向单独拉伸，>1 左右收窄、<1 横向拉宽
             field_length           = 长度：纵向单独拉伸，>1 上下留白增多、<1 近远景深拉长
             field_height           = 上下高度：整体垂直平移，正值下移、负值上移（不缩放）
             field_hand_shift       = 手卡后移：我方手卡沿 +Y 向后微调量（世界单位）
             field_preview_zones    = 预览开关：设计时是否显示区域槽位/堆叠区（仅编辑态生效）
             field_preview_hand     = 预览开关：设计时是否显示双方示例手卡（仅编辑态生效）
             field_preview_labels   = 预览开关：设计时是否显示堆叠区名称标签（仅编辑态生效） -->
        <cn.garymb.ygomobile.render.GameFieldView
            android:id="@+id/game_field_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:field_camera_elevation="52"
            app:field_camera_distance="6.8"
            app:field_zoom="1.1"
            app:field_width="1.0"
            app:field_length="1.0"
            app:field_height="0.0"
            app:field_hand_shift="0.0"
            app:field_preview_zones="true"
            app:field_preview_hand="true"
            app:field_preview_labels="true" />

        <!-- GameTopInfo区域（最上层） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:orientation="vertical">

            <!-- 顶部玩家信息区（常驻显示，悬浮于决斗场区域上方） -->
            <LinearLayout
                android:id="@+id/layout_top_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:orientation="horizontal">

                <!-- 我方信息面板（左上）：底层头像框+血条框（lpbarf 拆分为头像框/血条框两部分，
                     头像框单独适配头像尺寸、血条框自由拉伸），顶层名字/总卡数/倒计时 -->
                <FrameLayout
                    android:id="@+id/layout_player_panel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="5">

                    <!-- 底层：头像框 + 血条框 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- 头像框容器：头像贴图 + 叠加其上的头像框（lpbarf 行首 64px 镂空框），
                             容器尺寸由 GameTopInfoManager 按面板高度与 64:70 比例设定 -->
                        <FrameLayout
                            android:id="@+id/layout_player_avatar_box"
                            android:layout_width="50dp"
                            android:layout_height="match_parent">

                            <ImageView
                                android:id="@+id/iv_player_avatar"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:padding="4dp"
                                android:scaleType="fitXY"
                                android:src="@drawable/avatar" />

                            <ImageView
                                android:id="@+id/iv_player_avatar_frame"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="fitXY" />
                        </FrameLayout>

                        <!-- 血条框容器：LP 血条填充 + 叠加其上的血条框（lpbarf 行尾 241px 中段，自由拉伸）。
                             LP 血条（drawing.cpp L936-973 tLPBar，我方自左向右填充；每 8000 一节，超出部分叠加下一节颜色层） -->
                        <FrameLayout
                            android:id="@+id/layout_player_bar_box"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1">

                            <ImageView
                                android:id="@+id/iv_player_lp_bar"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_marginVertical="4dp"
                                android:layout_marginStart="2dp"
                                android:layout_marginEnd="4dp"
                                android:scaleType="fitXY"
                                android:src="@drawable/ygopro_selected_background" />

                            <ImageView
                                android:id="@+id/iv_player_lp_bar_layer"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_marginVertical="4dp"
                                android:layout_marginStart="2dp"
                                android:layout_marginEnd="4dp"
                                android:scaleType="fitXY"
                                android:visibility="gone" />

                            <ImageView
                                android:id="@+id/iv_player_bar_frame"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="fitXY" />
                        </FrameLayout>
                    </LinearLayout>

                    <!-- 顶层：玩家名字 / 总卡数 / 回合倒计时（paddingStart 由 Java 随头像框宽同步） -->
                    <LinearLayout
                        android:id="@+id/layout_player_info_col"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:paddingStart="50dp"
                        android:paddingEnd="5dp">

                        <TextView
                            android:id="@+id/tv_player_name"
                            android:layout_width="wrap_content"
                            android:layout_height="0dp"
                            android:layout_marginStart="5dp"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:maxLines="1"
                            android:shadowColor="@color/black"
                            android:shadowDx="0"
                            android:shadowDy="0"
                            android:shadowRadius="4"
                            android:text="Knight of Hanoi"
                            android:textColor="@color/white"
                            android:textSize="10sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tv_player_lp_number"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:maxLines="1"
                                android:shadowColor="@color/black"
                                android:shadowDx="2"
                                android:shadowDy="2"
                                android:shadowRadius="1"
                                android:text="8000"
                                android:textColor="@color/white"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="right|center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:id="@+id/iv_player_card_back"
                                    android:layout_width="wrap_content"
                                    android:layout_height="10sp"
                                    android:adjustViewBounds="true"
                                    android:scaleType="fitXY"
                                    android:src="@drawable/unknown" />

                                <TextView
                                    android:id="@+id/tv_player_card_count"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="2dp"
                                    android:gravity="center_vertical"
                                    android:text="0"
                                    android:textColor="#FFFFFF"
                                    android:textSize="10sp" />

                                <TextView
                                    android:id="@+id/tv_player_time"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginHorizontal="5dp"
                                    android:gravity="center_vertical"
                                    android:text="0"
                                    android:textColor="#FFFFFF"
                                    android:textSize="10sp"
                                    android:visibility="visible" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </FrameLayout>

                <!-- 中央回合计数器：外层 FrameLayout 承接行内权重 1 与 veil_mid_vertical 背景，
                     撤回提示图标叠加在回合数字下方（闪动发光 = 当前有可整段回退的动作） -->
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="2dp"
                    android:layout_weight="1"
                    android:background="@drawable/veil_mid_vertical"
                    android:clipChildren="false">

                    <TextView
                        android:id="@+id/tv_turn_counter"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:shadowColor="@color/white"
                        android:shadowDx="-2"
                        android:shadowDy="-1"
                        android:shadowRadius="1"
                        android:text="99"
                        android:textColor="@color/ygopro_list_background"
                        android:textSize="30sp"
                        android:textStyle="bold" />

                    <!-- 局域网撤回入口：平时 invisible，收到 STOC_UNDO_STATE=1 时由
                         GameTopInfoManager.setUndoPrompt 点亮并呼吸式闪动发光 -->
                    <ImageView
                        android:id="@+id/iv_undo"
                        android:layout_width="26dp"
                        android:layout_height="20dp"
                        android:layout_gravity="bottom|center_horizontal"
                        android:layout_marginBottom="1dp"
                        android:background="@drawable/undo_glow"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="5dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_undo"
                        android:visibility="invisible" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/layout_opponent_panel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="5">

                    <!-- 底层：血条框 + 头像框（镜像我方：血条框在左、头像框在右） -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- 血条框容器：LP 血条填充 + 叠加其上的血条框（lpbarf 行首 241px 中段，自由拉伸）。
                             LP 血条（drawing.cpp L936-973 tLPBar，对方自右向左填充；每 8000 一节，超出部分叠加下一节颜色层） -->
                        <FrameLayout
                            android:id="@+id/layout_opponent_bar_box"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1">

                            <ImageView
                                android:id="@+id/iv_opponent_lp_bar"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_marginVertical="4dp"
                                android:layout_marginStart="4dp"
                                android:layout_marginEnd="2dp"
                                android:scaleType="fitXY"
                                android:src="@drawable/ygopro_selected_background" />

                            <ImageView
                                android:id="@+id/iv_opponent_lp_bar_layer"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_marginVertical="4dp"
                                android:layout_marginStart="4dp"
                                android:layout_marginEnd="2dp"
                                android:scaleType="fitXY"
                                android:visibility="gone" />

                            <ImageView
                                android:id="@+id/iv_opponent_bar_frame"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="fitXY" />
                        </FrameLayout>

                        <!-- 头像框容器：头像贴图 + 叠加其上的头像框（lpbarf 行尾 64px 镂空框） -->
                        <FrameLayout
                            android:id="@+id/layout_opponent_avatar_box"
                            android:layout_width="50dp"
                            android:layout_height="match_parent">

                            <ImageView
                                android:id="@+id/iv_opponent_avatar"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:padding="4dp"
                                android:scaleType="fitXY"
                                android:src="@drawable/avatar" />

                            <ImageView
                                android:id="@+id/iv_opponent_avatar_frame"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="fitXY" />
                        </FrameLayout>
                    </LinearLayout>

                    <!-- 顶层：玩家名字 / 总卡数 / 回合倒计时（镜像我方：名字靠右，第二行左对齐 倒计时/总卡数/卡背图标；paddingEnd 由 Java 随头像框宽同步） -->
                    <LinearLayout
                        android:id="@+id/layout_opponent_info_col"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:paddingStart="5dp"
                        android:paddingEnd="50dp">

                        <TextView
                            android:id="@+id/tv_opponent_name"
                            android:layout_width="wrap_content"
                            android:layout_height="0dp"
                            android:layout_gravity="end"
                            android:layout_marginEnd="5dp"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:gravity="center"
                            android:maxLines="1"
                            android:shadowColor="@color/black"
                            android:shadowDx="0"
                            android:shadowDy="0"
                            android:shadowRadius="4"
                            android:text="Opponent"
                            android:textColor="@color/white"
                            android:textSize="10sp" />

                        <!-- 第二行（镜像我方）：LP 数字居中，倒计时/总卡数/卡背图标靠左 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="left|center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/tv_opponent_time"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginHorizontal="5dp"
                                    android:gravity="center_vertical"
                                    android:text="0"
                                    android:textColor="@color/white"
                                    android:textSize="10sp"
                                    android:visibility="visible" />

                                <ImageView
                                    android:id="@+id/iv_opponent_card_back"
                                    android:layout_width="wrap_content"
                                    android:layout_height="10sp"
                                    android:adjustViewBounds="true"
                                    android:scaleType="fitXY"
                                    android:src="@drawable/unknown" />

                                <TextView
                                    android:id="@+id/tv_opponent_card_count"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="2dp"
                                    android:gravity="center_vertical"
                                    android:text="0"
                                    android:textColor="@color/white"
                                    android:textSize="10sp" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/tv_opponent_lp_number"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:maxLines="1"
                                android:shadowColor="@color/black"
                                android:shadowDx="2"
                                android:shadowDy="2"
                                android:shadowRadius="1"
                                android:text="8000"
                                android:textColor="@color/white"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>

            <!-- 聊天消息区域：对局内分侧聊天与弹幕均已迁至 SpecEffectOverlay 的 PopupWindow 层
                 （普通 View 会被 setZOrderOnTop 的 GL 曲面遮挡），本容器实际只承载居中的提示栏；
                 行高 = 提示栏固定高（+margin）→ 恒定量，相机上锚线不会因聊天/提示内容而变 -->
            <FrameLayout
                android:id="@+id/layout_chat_messages"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center|top"
                android:orientation="horizontal"
                android:visibility="visible">

                <TextView
                    android:id="@+id/tv_chat_message_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start"
                    android:layout_marginStart="50dp"
                    android:maxLines="5"
                    android:ellipsize="end"
                    android:background="#A0000000"
                    android:textColor="@color/white"
                    android:textSize="7sp"
                    android:visibility="gone" />

                <!-- 提示信息（对齐 gframe stHintMsg 单行静态文本）：高度固定 30dp + 单行尾部省略，
                     并由 GameFieldController.hideDuelHint 以 INVISIBLE 隐藏（恒占位），使相机上锚线
                     不随提示显隐与文本长度变化（否则决斗场取景会随之重解而晃动）。
                     外边距 2dp（原 5dp）：本行整高就是相机上锚线的占地，收窄边距不缩字号就把
                     纵向净空让给决斗场（全面屏卡片/决斗场因此等比变大） -->
                <TextView
                    android:id="@+id/tv_hint_message"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_margin="2dp"
                    android:background="@drawable/btn_sci_fi_bg"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:padding="2dp"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:visibility="invisible" />

                <TextView
                    android:id="@+id/tv_chat_message_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:background="#A0000000"
                    android:layout_marginEnd="50dp"
                    android:maxLines="5"
                    android:ellipsize="end"
                    android:textColor="@color/white"
                    android:textSize="7sp"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <!-- 系统/观战消息弹幕回退层（仅供 drawspec 覆盖层不可用时兜底；正常弹幕宿主是
             SpecEffectOverlay PopupWindow 层贴屏幕顶部的全屏横带，最多 3 行，不受 GL 曲面遮挡。
             本层在 GameFieldView(setZOrderOnTop) 之下，叠在其上仅作历史保留，对齐 drawing.cpp DrawChatMsg） -->
        <FrameLayout
            android:id="@+id/layout_danmaku"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:clipChildren="false" />

        <!-- 表情气泡（对齐 gframe drawing.cpp DrawEmoticon）：收到表情聊天时显示在发送方头像下方，由 GameFieldController 定时自动隐藏 -->
        <ImageView
            android:id="@+id/iv_player_emote_bubble"
            android:layout_width="44dp"
            android:layout_height="52dp"
            android:layout_gravity="start|top"
            android:layout_marginStart="3dp"
            android:layout_marginTop="50dp"
            android:background="@drawable/bg_emote_bubble"
            android:contentDescription="@null"
            android:paddingStart="3dp"
            android:paddingTop="11dp"
            android:paddingEnd="3dp"
            android:paddingBottom="3dp"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/iv_opponent_emote_bubble"
            android:layout_width="44dp"
            android:layout_height="52dp"
            android:layout_gravity="end|top"
            android:layout_marginEnd="3dp"
            android:layout_marginTop="50dp"
            android:background="@drawable/bg_emote_bubble"
            android:contentDescription="@null"
            android:paddingStart="3dp"
            android:paddingTop="11dp"
            android:paddingEnd="3dp"
            android:paddingBottom="3dp"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <!-- 底部功能行（贴本区域底缘，同一水平行，用户规格：6 按钮列与聊天输入框位置相关联、
             互不重叠）：六按钮列锚最左，聊天输入框紧随其右、底部对齐 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:clipChildren="false"
            android:orientation="horizontal">

            <!-- 聊天输入框：0dp+weight 只占六按钮列右侧的剩余宽度（不再 match_parent 顶到最左被聊天开关遮挡），
                 树内按钮列 INVISIBLE 仅保留宽度占位、浮层落在其上（占位宽由 syncPlaceholderWidthToOverlay 实时
                 锁为浮层真实宽），marginStart=2dp 即输入框与聊天开关按钮列的精确间距，
                 底部对齐与按钮列同高（高度经 YGOProActivity.syncChatInputHeightToToggle 同步 btn_chat 实测值） -->
            <EditText
                android:id="@+id/et_chat_input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_gravity="bottom"
                android:layout_marginStart="2dp"
                android:background="@drawable/ygopro_base_background"
                android:gravity="center_vertical"
                android:imeOptions="actionSend|flagNoExtractUi"
                android:inputType="text"
                android:maxLines="1"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:textColor="@color/white"
                android:textSize="9sp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
