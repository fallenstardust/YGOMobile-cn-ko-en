<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/yes_no_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/sdialogl"
    android:paddingHorizontal="20dp"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btn_dialog_collapse"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/baseline_keyboard_arrow_down_24"
            android:background="@drawable/selected_light"
            android:scaleType="centerInside"
            android:adjustViewBounds="true"
            android:layout_gravity="start"/>

        <TextView
            android:id="@+id/tv_yes_no_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="2dp"
            android:layout_gravity="center"
            android:gravity="center_vertical|start"
            android:textColor="@color/white"
            android:text="标题"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="5dp"
        android:orientation="vertical"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Card image area for card name display -->
            <ImageView
                android:id="@+id/iv_yes_no_card_image"
                android:layout_width="30dp"
                android:layout_height="43dp"
                android:layout_gravity="center"
                android:layout_marginEnd="2dp"
                android:padding="1dp"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                android:background="@drawable/ygopro_deck_background"/>

            <!-- Default message content -->
            <ScrollView
                android:id="@+id/yes_no_scroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:scrollbars="none">

                <TextView
                    android:id="@+id/tv_yes_no_message"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical|start"
                    android:textColor="@color/white"
                    android:textSize="12sp" />
            </ScrollView>
        </LinearLayout>
        <!-- Chain card horizontal list for chain query dialog -->
        <HorizontalScrollView
            android:id="@+id/hsv_yes_no_chain_cards"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:fillViewport="true"
            android:scrollbars="none">
        
            <LinearLayout
                android:id="@+id/ll_chain_card_list"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_horizontal"
                android:paddingVertical="8dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"/>
        </HorizontalScrollView>
        <!-- Custom content placeholder -->
        <FrameLayout
            android:id="@+id/yes_no_custom_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_weight="1"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Button area -->
    <LinearLayout
        android:id="@+id/yes_no_button_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_yes_no_positive"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="20dp"
            android:background="@drawable/button3_bg"
            android:minWidth="90dp"
            android:minHeight="30dp"
            android:text="是"
            android:textColor="@color/white"
            android:textSize="10sp" />

        <Button
            android:id="@+id/btn_yes_no_negative"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/button3_bg"
            android:minWidth="90dp"
            android:minHeight="30dp"
            android:text="否"
            android:textColor="@color/white"
            android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>