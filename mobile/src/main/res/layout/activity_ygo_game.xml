<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 主内容区：左侧卡片详情 + 右侧（玩家信息 + 决斗场） -->
    <LinearLayout
        android:id="@+id/layout_game_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <!-- 左侧卡片详情面板（常驻显示） -->
        <include
            android:id="@+id/layout_card_detail_panel"
            layout="@layout/layout_card_detail_panel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.3" />

        <!-- 卡组编辑器视图 -->
        <include
            android:id="@+id/layout_deck_editor"
            layout="@layout/layout_deck_editor"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.7"
            android:visibility="gone" />

        <!-- 右侧区域（垂直）：顶部玩家信息 + 决斗场 -->
        <include
            android:id="@+id/layout_game_right"
            layout="@layout/layout_game_right"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.7" />
    </LinearLayout>

    <!-- 对话框容器 -->
    <FrameLayout
        android:id="@+id/dialog_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

</FrameLayout>
