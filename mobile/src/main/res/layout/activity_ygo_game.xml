<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 主内容区：左侧卡片详情 + 右侧（玩家信息 + 决斗场） -->
    <LinearLayout
        android:id="@+id/layout_game_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <!-- 左侧卡片详情面板（常驻显示） -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.3"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/layout_card_detail"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.85"
                android:orientation="vertical"
                android:padding="1dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="0.45">

                    <ImageView
                        android:id="@+id/iv_card_image"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_alignParentStart="true"
                        android:adjustViewBounds="true"
                        android:scaleType="fitCenter"
                        android:src="@drawable/unknown" />

                    <!-- 时点按钮（投降/时点控制） -->
                    <LinearLayout
                        android:id="@+id/layout_bottom_actions"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginStart="2dp"
                        android:layout_toEndOf="@id/iv_card_image"
                        android:orientation="vertical"
                        android:visibility="visible">

                        <Button
                            android:id="@+id/btn_surrender"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_marginBottom="2dp"
                            android:layout_weight="1.2"
                            android:background="@drawable/button3_bg"
                            android:text="投降"
                            android:textColor="@color/white"
                            android:textSize="10sp" />

                        <Button
                            android:id="@+id/btn_ignore_timing"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_marginBottom="2dp"
                            android:layout_weight="1"
                            android:background="@drawable/button3_bg"
                            android:text="忽略时点"
                            android:textColor="@color/white"
                            android:textSize="10sp" />

                        <Button
                            android:id="@+id/btn_show_timing"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_marginBottom="2dp"
                            android:layout_weight="1"
                            android:background="@drawable/button3_bg"
                            android:text="显示时点"
                            android:textColor="@color/white"
                            android:textSize="10sp" />

                        <Button
                            android:id="@+id/btn_available_timing"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_marginBottom="2dp"
                            android:layout_weight="1"
                            android:background="@drawable/button3_bg"
                            android:text="可用时点"
                            android:textColor="@color/white"
                            android:textSize="10sp" />

                        <Button
                            android:id="@+id/btn_shuffle_hand"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1.2"
                            android:background="@drawable/button3_bg"
                            android:text="洗切手卡"
                            android:textColor="@color/white"
                            android:textSize="10sp"
                            android:visibility="invisible" />

                        <Button
                            android:id="@+id/btn_cancel_or_finish"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1.2"
                            android:background="@drawable/button3_bg"
                            android:text="完成选择"
                            android:textColor="@color/white"
                            android:textSize="10sp"
                            android:visibility="gone" />

                    </LinearLayout>
                    <!-- 录像控制按钮 -->
                    <LinearLayout
                        android:id="@+id/layout_replay_control"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginStart="2dp"
                        android:layout_toEndOf="@id/iv_card_image"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <Button
                            android:id="@+id/btn_replay_play"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_marginBottom="2dp"
                            android:layout_weight="1"
                            android:background="@drawable/button3_bg"
                            android:text="播放"
                            android:textColor="@color/white"
                            android:textSize="10sp" />

                        <Button
                            android:id="@+id/btn_replay_pause"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_marginBottom="2dp"
                            android:layout_weight="1"
                            android:background="@drawable/button3_bg"
                            android:text="暂停"
                            android:textColor="@color/white"
                            android:textSize="10sp" />

                        <Button
                            android:id="@+id/btn_replay_next"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_marginBottom="2dp"
                            android:layout_weight="1"
                            android:background="@drawable/button3_bg"
                            android:text="下一步"
                            android:textColor="@color/white"
                            android:textSize="10sp" />

                        <Button
                            android:id="@+id/btn_replay_last"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_marginBottom="2dp"
                            android:layout_weight="1"
                            android:background="@drawable/button3_bg"
                            android:text="上一步"
                            android:textColor="@color/white"
                            android:textSize="10sp" />

                        <Button
                            android:id="@+id/btn_replay_shuffle"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_marginBottom="2dp"
                            android:layout_weight="1"
                            android:background="@drawable/button3_bg"
                            android:text="切换视角"
                            android:textColor="@color/white"
                            android:textSize="10sp" />

                        <Button
                            android:id="@+id/btn_replay_quit"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:background="@drawable/button3_bg"
                            android:text="退出"
                            android:textColor="@color/white"
                            android:textSize="10sp" />
                    </LinearLayout>
                    <!-- 卡组操作按钮 -->
                    <LinearLayout
                        android:id="@+id/layout_deck_control"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginStart="2dp"
                        android:layout_toEndOf="@id/iv_card_image"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <Button
                            android:id="@+id/btn_deck_exit"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_marginBottom="2dp"
                            android:layout_weight="1"
                            android:background="@drawable/button3_bg"
                            android:text="@string/quit"
                            android:textColor="@color/white"
                            android:textSize="10sp" />

                        <Button
                            android:id="@+id/btn_deck_shuffle"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_marginBottom="2dp"
                            android:layout_weight="1"
                            android:background="@drawable/button3_bg"
                            android:text="@string/unsort"
                            android:textColor="@color/white"
                            android:textSize="10sp" />

                        <Button
                            android:id="@+id/btn_deck_sort"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_marginBottom="2dp"
                            android:layout_weight="1"
                            android:background="@drawable/button3_bg"
                            android:text="@string/sort"
                            android:textColor="@color/white"
                            android:textSize="10sp" />

                        <Button
                            android:id="@+id/btn_deck_clear"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_marginBottom="2dp"
                            android:layout_weight="1"
                            android:background="@drawable/button3_bg"
                            android:text="@string/clear_deck"
                            android:textColor="@color/white"
                            android:textSize="10sp" />

                        <Button
                            android:id="@+id/btn_deck_delete"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_marginBottom="2dp"
                            android:layout_weight="1"
                            android:background="@drawable/button3_bg"
                            android:text="@string/delete"
                            android:textColor="@color/white"
                            android:textSize="10sp" />
                    </LinearLayout>
                </RelativeLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="0.55"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginTop="2dp"
                        android:layout_weight="1"
                        android:background="@drawable/window3"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_card_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/ygopro_deck_background"
                            android:gravity="center"
                            android:padding="2dp"
                            android:text="Unknown[999999999]"
                            android:textColor="@color/white"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_card_attr"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="[怪兽|效果] 种族/属性"
                            android:textColor="@color/holo_green_bright"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/tv_card_level"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="[★13] 5000/5000"
                            android:textColor="@color/yellow"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/tv_card_setname"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="字段：????"
                            android:textColor="@color/holo_orange_bright"
                            android:textSize="10sp"
                            android:visibility="visible" />

                        <ScrollView
                            android:id="@+id/sv_card_desc"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_marginTop="6dp"
                            android:layout_weight="1">

                            <TextView
                                android:id="@+id/tv_card_desc"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:textColor="@color/white"
                                android:textSize="11sp" />
                        </ScrollView>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="0.15"
                        android:layout_marginStart="2dp"
                        android:orientation="vertical">

                        <ImageButton
                            android:id="@+id/btn_settings"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_marginBottom="5dp"
                            android:layout_weight="1"
                            android:background="@drawable/btn_sci_fi_bg"
                            android:padding="4dp"
                            android:scaleType="centerInside"
                            android:src="@drawable/setting" />

                        <ImageButton
                            android:id="@+id/btn_note"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_marginBottom="5dp"
                            android:layout_weight="1"
                            android:background="@drawable/btn_sci_fi_bg"
                            android:padding="4dp"
                            android:scaleType="centerInside"
                            android:src="@drawable/ic_note" />

                        <ImageButton
                            android:id="@+id/btn_sound"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_marginBottom="5dp"
                            android:layout_weight="1"
                            android:background="@drawable/btn_sci_fi_bg"
                            android:padding="4dp"
                            android:scaleType="centerInside"
                            android:src="@drawable/ic_volume_on" />

                        <ImageButton
                            android:id="@+id/btn_speed"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_marginBottom="5dp"
                            android:layout_weight="1"
                            android:background="@drawable/btn_sci_fi_bg"
                            android:padding="4dp"
                            android:scaleType="centerInside"
                            android:src="@drawable/ic_speed" />

                        <ImageButton
                            android:id="@+id/btn_emote"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_marginBottom="5dp"
                            android:layout_weight="1"
                            android:background="@drawable/btn_sci_fi_bg"
                            android:padding="4dp"
                            android:scaleType="centerInside"
                            android:src="@drawable/ic_emoticon" />

                        <ImageButton
                            android:id="@+id/btn_chat"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:background="@drawable/btn_sci_fi_bg"
                            android:padding="4dp"
                            android:scaleType="centerInside"
                            android:src="@drawable/rename" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- 卡组编辑器视图 -->
        <include
            android:id="@+id/layout_deck_editor"
            layout="@layout/layout_deck_editor"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.7"
            android:visibility="gone" />

        <!-- 右侧区域（垂直）：顶部玩家信息 + 决斗场 -->
        <LinearLayout
            android:id="@+id/layout_game_right"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.7"
            android:orientation="vertical">

            <!-- 顶部玩家信息区（常驻显示） -->
            <LinearLayout
                android:id="@+id/layout_top_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="4dp">

                <!-- 我方信息面板（左上） -->
                <LinearLayout
                    android:id="@+id/layout_player_panel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/ygopro_deck_background"
                    android:orientation="horizontal"
                    android:padding="6dp">

                    <ImageView
                        android:id="@+id/iv_player_avatar"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/avatar" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_player_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="left"
                            android:shadowColor="#FF00E5FF"
                            android:shadowDx="0"
                            android:shadowDy="0"
                            android:shadowRadius="4"
                            android:text="Player"
                            android:textColor="#AAFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tv_player_lp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:shadowColor="#FF00FF88"
                                android:shadowDx="0"
                                android:shadowDy="0"
                                android:shadowRadius="3"
                                android:text="8000"
                                android:textColor="#00FF88"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_player_time"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:layout_marginStart="8dp"
                                android:text=""
                                android:textColor="#FFFFFF"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:visibility="gone" />

                            <TextView
                                android:id="@+id/tv_player_hand_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="12dp"
                                android:text="手卡:5"
                                android:textColor="#88CCFF"
                                android:textSize="12sp" />


                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- 中央回合计数器 -->
                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp">

                    <TextView
                        android:id="@+id/tv_turn_counter"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:background="@drawable/turn_counter_bg"
                        android:gravity="center"
                        android:shadowColor="#FF00E5FF"
                        android:shadowDx="0"
                        android:shadowDy="0"
                        android:shadowRadius="6"
                        android:text="5"
                        android:textColor="#FFFFFF"
                        android:textSize="28sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <!-- 对手信息面板（右上） -->
                <LinearLayout
                    android:id="@+id/layout_opponent_panel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/ygopro_deck_background"
                    android:orientation="horizontal"
                    android:padding="6dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_opponent_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="right"
                            android:shadowColor="#FF00E5FF"
                            android:shadowDx="0"
                            android:shadowDy="0"
                            android:shadowRadius="4"
                            android:text="Opponent"
                            android:textColor="#AAFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tv_opponent_hand_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:text="手卡:5"
                                android:textColor="#88CCFF"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tv_opponent_time"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:layout_marginEnd="8dp"
                                android:text=""
                                android:textColor="#FFFFFF"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:visibility="gone" />

                            <TextView
                                android:id="@+id/tv_opponent_lp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:shadowColor="#FFFF8800"
                                android:shadowDx="0"
                                android:shadowDy="0"
                                android:shadowRadius="3"
                                android:text="8000"
                                android:textColor="#FFD700"
                                android:textSize="18sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/iv_opponent_avatar"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/avatar" />
                </LinearLayout>
            </LinearLayout>

            <!-- 提示信息 -->
            <TextView
                android:id="@+id/tv_hint_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="@drawable/ygopro_deck_background"
                android:padding="3dp"
                android:text="请选择要特殊召唤的怪兽（9-9）"
                android:textColor="@color/white"
                android:textSize="12sp" />

            <!-- 决斗场区域（填充剩余空间） -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <cn.garymb.ygomobile.render.GameFieldView
                    android:id="@+id/game_field_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="visible" />

                <!-- 聊天消息区域 -->
                <LinearLayout
                    android:id="@+id/layout_chat_messages"
                    android:layout_width="200dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end|top"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/ygopro_deck_background"
                    android:orientation="horizontal"
                    android:padding="6dp"
                    android:visibility="visible">

                    <TextView
                        android:id="@+id/tv_chat_message_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start"
                        android:background="#40000000"
                        android:padding="3dp"
                        android:textColor="@color/white"
                        android:textSize="8sp"
                        android:visibility="visible" />

                    <TextView
                        android:id="@+id/tv_chat_message_2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:background="#40000000"
                        android:padding="3dp"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:visibility="visible" />
                </LinearLayout>

                <!-- 阶段按钮组（决斗场中轴位置横向3个） -->
                <FrameLayout
                    android:id="@+id/layout_phase_buttons"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="horizontal"
                    android:visibility="visible">

                    <Button
                        android:id="@+id/btn_phase_current"
                        android:layout_width="60dp"
                        android:layout_height="30dp"
                        android:layout_gravity="left"
                        android:background="@drawable/button3_bg"
                        android:text="DP"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btn_phase_next"
                        android:layout_width="60dp"
                        android:layout_height="30dp"
                        android:layout_gravity="center"
                        android:background="@drawable/button3_bg"
                        android:text="BP"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btn_ep"
                        android:layout_width="60dp"
                        android:layout_height="30dp"
                        android:layout_gravity="right"
                        android:background="@drawable/button3_bg"
                        android:text="EP"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </FrameLayout>
            </FrameLayout>

            <EditText
                android:id="@+id/et_chat_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:hint="发送消息..."
                android:textColorHint="#80FFFFFF"
                android:inputType="text"
                android:maxLines="1"
                android:imeOptions="actionSend|flagNoExtractUi"
                android:textColor="@color/white"
                android:background="@drawable/ygopro_deck_background"/>
        </LinearLayout>
    </LinearLayout>

    <!-- 对话框容器 -->
