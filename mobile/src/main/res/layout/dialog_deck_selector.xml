<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/window3"
    android:padding="12dp">

    <!-- 左右分栏：左侧分类，右侧卡组 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_margin="5dp"
        android:orientation="horizontal">

        <!-- 左侧：分类列表 -->
        <ListView
            android:id="@+id/lv_categories"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.5"
            android:background="#1A3A4A"
            android:divider="#3A5A6B"
            android:dividerHeight="1dp" />

        <!-- 中间分隔条 -->
        <View
            android:layout_width="2dp"
            android:layout_height="match_parent"
            android:background="#4A6A7B"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp"/>

        <!-- 右侧：卡组列表 -->
        <ListView
            android:id="@+id/lv_decks"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.5"
            android:background="#1A3A4A"
            android:divider="#3A5A6B"
            android:dividerHeight="1dp" />
    </LinearLayout>

        <Button
            android:id="@+id/btn_confirm_deck"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ok"
            android:layout_gravity="center"
            android:background="@drawable/button3_bg"
            android:textColor="@color/white"
            android:textSize="14sp"/>
</LinearLayout>