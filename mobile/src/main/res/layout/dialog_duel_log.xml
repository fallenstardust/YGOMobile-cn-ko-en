<?xml version="1.0" encoding="utf-8"?>
<!-- 决斗日志对话框（对应桌面版 gframe wLogs：lstLog + btnClearLog + btnCloseLog，game.cpp L624-633；
     顶部增加「消息记录/聊天记录」双 tab，Android 端扩展：聊天tab 记录对局/录像全部聊天，长按条目复制） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/duel_log_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/window2s"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- tab 条：文本与配色由 DuelLogDialog.selectTab 代码设置（选中=duel_log_card_text，未选=chat_color_gray） -->
    <LinearLayout
        android:id="@+id/layout_duel_log_tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_tab_duel_log_msg"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingVertical="3dp"
            android:textColor="@color/white"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/btn_tab_duel_log_chat"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingVertical="3dp"
            android:textColor="@color/white"
            android:textSize="10sp" />
    </LinearLayout>

    <ListView
        android:id="@+id/lv_duel_log"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="0.9"
        android:background="@drawable/ygopro_deck_background"
        android:choiceMode="none"
        android:divider="@color/transparent"
        android:dividerHeight="2dp"
        android:listSelector="@android:color/transparent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.1"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_duel_log_clear"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/button3_bg"
            android:text="@string/clear_deck"
            android:textColor="@color/white"
            android:textSize="10sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="0.5"/>

        <Button
            android:id="@+id/btn_duel_log_close"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/button3_bg"
            android:text="@string/ok"
            android:textColor="@color/white"
            android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>