<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="SearchableSpinner">
        <attr name="hintText" format="string" />
        <attr name="searchTitle" format="string" />
    </declare-styleable>
    <declare-styleable name="CardGroupView">
        <attr name="lines" format="integer" />
        <attr name="card_width" format="integer" />
        <attr name="card_height" format="integer" />
        <attr name="line_limit" format="integer" />
        <attr name="line_max_count" format="integer" />
    </declare-styleable>
    <declare-styleable name="ShimmerView">
        <attr name="reflectionColor" format="color" />
    </declare-styleable>
    <!-- 决斗场渲染视图 GameFieldView：布局参数可在 XML 中调整并在设计时预览中实时查看 -->
    <declare-styleable name="GameFieldView">
        <!-- 相机俯仰角（度，35~75）：越大越接近正俯视；在 XML 中显式声明时优先于游戏内保存的设置 -->
        <attr name="field_camera_elevation" format="float" />
        <!-- 视点到注视点距离：与俯仰角共同决定相机位置（默认 7.6）。
             这是「对方场上卡片显得远/小」的主调参旋钮：值越大→透视越平（近大远小削弱）→
             对方侧变大变近，取景按宽度自适应回满屏不缩小卡片；横屏取 10.0，竖屏取 7.6。
             完整微调说明见 layout/layout_game_right.xml 的「决斗场微调参数总览」。 -->
        <attr name="field_camera_distance" format="float" />
        <!-- 场地视觉倍率（等比总缩放，默认 1.0）：横竖同一基准缩放决斗场，1.0 = 场地近端左右边缘精确贴合视图左右缘 -->
        <attr name="field_zoom" format="float" />
        <!-- 宽度（横向拉伸，默认 1.0）：在 field_zoom 等比缩放之上单独乘算横向视锥半宽。
             >1 横向视野变宽（决斗场左右收窄、两侧留白增多）；<1 决斗场横向拉宽。仅作用于横向、不改纵向。 -->
        <attr name="field_width" format="float" />
        <!-- 长度（纵向拉伸，默认 1.0）：单独乘算竖向视锥半高，改变我方↔对方近远景深在屏幕上的拉长/压缩。
             >1 纵向视野变高（决斗场前后压缩、上下留白增多）；<1 决斗场纵向拉长。仅作用于纵向、不改横向。 -->
        <attr name="field_length" format="float" />
        <!-- 上下高度（整体垂直平移，默认 0.0）：在离轴量上叠加偏移，使整个决斗场在屏幕上上下移动而不缩放。
             正值决斗场整体下移、负值上移。 -->
        <attr name="field_height" format="float" />
        <!-- 我方手卡沿 +Y 向后平移量（世界单位，默认 0.7）：使手卡底边略高于视图底边 -->
        <attr name="field_hand_shift" format="float" />
        <!-- 设计时预览：是否显示区域槽位与堆叠区（默认 true，仅 isInEditMode 生效） -->
        <attr name="field_preview_zones" format="boolean" />
        <!-- 设计时预览：是否显示双方示例手卡（默认 true，仅 isInEditMode 生效） -->
        <attr name="field_preview_hand" format="boolean" />
        <!-- 设计时预览：是否显示堆叠区名称标签（默认 true，仅 isInEditMode 生效） -->
        <attr name="field_preview_labels" format="boolean" />
    </declare-styleable>
</resources>